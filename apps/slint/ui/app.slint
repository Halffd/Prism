// Prism desktop UI (Slint). State lives in Rust (prism-core + main.rs);
// this file is presentation only.

import { Button, ComboBox, LineEdit, CheckBox, ListView, ScrollView, Slider, TextEdit } from "std-widgets.slint";

export struct ChatLine {
    role: string,      // "user" | "assistant" | "system"
    content: string,
    thinking: string,  // extracted reasoning; empty = none
}

export struct ChatRow {
    id: string,
    title: string,
    confirming: bool,  // delete pressed once; second press deletes
}

export struct KeyRow {
    provider: string,
    label: string,
    key: string,
}

export struct ProviderRow {
    id: string,
    label: string,
}

export struct PaletteRow {
    id: string,       // dispatch id ("chat.new") or "model:<id>"
    title: string,    // display text
    group: string,    // section label
}

export struct TreeRow {
    rel: string,      // workspace-relative path (shown indented by depth)
    isDir: bool,
    depth: int,
}

// Video studio: a model card is one selectable engine; a tile is one
// finished clip in the workspace grid. Gradient colors are derived in
// Rust from the model's hue (Slint has no hsl()).
export struct StudioModel {
    name: string,
    spec: string,     // "480-4k | 4-30s"
    features: string, // "Reference · Start-End · Audio"
    badge: string,    // "" | "Top pick" | "Fast" | "New"
    c1: color,
    c2: color,
}

export struct StudioTile {
    title: string,
    ratio: string,
    res: string,
    dur: string,
    model: string,
    c1: color,
    c2: color,
}

// Image studio: one finished image in the result grid (pixels for the
// native renderer / decoded data URLs; `image` is empty for remote
// URL-only tiles), and one LoRA adapter row in the panel.
export struct ImageTileUi {
    image: image,
    label: string,
    url: string,
}

export struct ImageLoraRow {
    name: string,
    weight: string,
}

// One finished clip in the workspace list: vibe gradient thumbnail
// with a play glyph, title, spec line, model in the studio purple.
component TileCard inherits Rectangle {
    in property <StudioTile> tile;
    height: 76px;
    background: #161616;
    border-width: 1px;
    border-color: #333333;
    border-radius: 8px;
    clip: true;
    HorizontalLayout {
        padding: 6px;
        spacing: 8px;
        Rectangle {
            width: 64px;
            background: @linear-gradient(140deg, tile.c1, tile.c2);
            border-radius: 6px;
            clip: true;
            Text {
                text: "▶";
                color: rgba(255, 255, 255, 0.9);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 2px;
            Text {
                text: tile.title;
                color: #ffffff;
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: tile.ratio + " · " + tile.res + " · " + tile.dur;
                color: #a3a3a3;
                font-size: 9px;
            }
            Text {
                text: tile.model;
                color: #c084fc;
                font-size: 9px;
            }
        }
    }
}

// Image studio: a node-style parameter group (ComfyUI's node bodies).
component NodeSection inherits Rectangle {
    in property <string> title;
    background: #141414;
    border-width: 1px;
    border-color: #2c2c2c;
    border-radius: 8px;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: title;
            color: #c084fc;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        @children
    }
}

// A − value + stepper for integer knobs (batch size, CLIP skip).
component IntStepper inherits Rectangle {
    in property <int> value;
    in property <int> min: 1;
    in property <int> max: 8;
    callback changed(int); // +/- 1
    height: 24px;
    HorizontalLayout {
        spacing: 4px;
        Rectangle {
            width: 26px;
            background: value > min ? #1e1e1e : #161616;
            border-width: 1px;
            border-color: #333333;
            border-radius: 6px;
            TouchArea {
                enabled: value > min;
                clicked => { changed(-1); }
                mouse-cursor: pointer;
            }
            Text {
                text: "−";
                color: value > min ? #ffffff : #555555;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: #1e1e1e;
            border-width: 1px;
            border-color: #333333;
            border-radius: 6px;
            Text {
                text: "\{value}";
                color: #ffffff;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            width: 26px;
            background: value < max ? #1e1e1e : #161616;
            border-width: 1px;
            border-color: #333333;
            border-radius: 6px;
            TouchArea {
                enabled: value < max;
                clicked => { changed(1); }
                mouse-cursor: pointer;
            }
            Text {
                text: "+";
                color: value < max ? #ffffff : #555555;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Prism";
    preferred-width: 1150px;
    preferred-height: 780px;
    min-width: 720px;
    min-height: 520px;
    background: #101418;

    // ---- state driven from Rust ----
    in property <[ChatLine]> transcript;
    in property <[ChatRow]> chats;
    in property <[string]> provider-labels;
    in property <[KeyRow]> api-keys;
    in property <[string]> cached-models;
    in property <[string]> compute-labels;
    in-out property <int> provider-idx;
    in-out property <int> connection-idx;
    in-out property <int> compute-idx;
    in property <string> provider;
    in property <string> model;
    in property <string> model-hint;
    in-out property <bool> show-chats: true;
    in-out property <bool> show-settings: true;
    in property <bool> streaming;
    in property <string> models-status;
    in property <string> settings-status;
    in property <string> prism-url;
    in property <string> prism-token;
    in property <string> local-url;
    in-out property <float> temperature;
    in property <string> max-tokens;
    in property <string> top-p;
    in property <string> freq-penalty;
    in property <string> pres-penalty;
    in property <string> system-prompt;
    in-out property <bool> thinking-enabled;
    in property <string> gpu-label;
    in property <string> ctx-label;
    in-out property <string> input-text;
    // ---- modes ----
    in-out property <int> pmode-idx: 0;
    in property <bool> mode-tools;
    in property <bool> mode-cards;
    in property <bool> mode-media;
    in property <bool> mode-tasks;
    in property <bool> mode-strategy;
    in-out property <int> gen-cap-idx: 0;
    in property <[string]> pmode-labels;
    in property <[string]> pmode-blurbs;
    in property <[string]> gen-cap-labels;
    // ---- mode mixing ----
    // Which rail tiles are blended into the session (the primary is
    // pmode-idx). A tile can be both primary and mixed.
    in property <[bool]> pmode-mixed;
    in property <string> pmode-blend-summary;
    in property <bool> show-mix-editor;
    // ---- capability editor ----
    in property <[PaletteRow]> cap-rows;
    in property <bool> show-cap-editor;
    // ---- permissions editor ----
    in property <[PaletteRow]> perm-rows;
    in property <bool> show-perm-editor;
    in property <string> perm-default;
    // ---- agent mode ----
    in-out property <int> agent-strategy-idx: 0;
    in-out property <string> agent-task;
    in property <bool> agent-busy;
    in property <string> agent-status;
    in property <[PaletteRow]> agent-steps;
    // ---- daemon mode ----
    in property <[PaletteRow]> daemon-tasks;
    in-out property <string> daemon-name;
    in-out property <string> daemon-instruction;
    in-out property <string> daemon-interval;
    // ---- character cards / persona ----
    in-out property <string> card-path;        // path to a V2/V1 card JSON
    in-out property <string> persona-name;
    in-out property <string> persona-desc;
    in property <bool> card-loaded;
    in property <string> card-summary;         // "Aria · engineer · 2 greetings"
    in-out property <bool> prompt-engine-on: false;
    // ---- data sync ----
    in-out property <string> sync-status;
    in-out property <string> sync-login-email;
    in-out property <string> sync-login-password;
    in property <bool> sync-logged-in;
    // ---- custom providers ----
    in-out property <string> new-provider-id;
    in-out property <int> new-provider-canonical-idx: 0;
    in-out property <string> new-provider-url;
    in property <[string]> canonical-labels;
    in property <[ProviderRow]> custom-provider-rows;
    // ---- command palette ----
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query;
    in property <[PaletteRow]> palette-results;
    in-out property <int> palette-idx: 0;
    // ---- media (image / video / 3D) ----
    in property <[string]> media-kind-labels;
    in property <[string]> media-provider-labels;
    in-out property <int> media-kind-idx: 0;
    in-out property <int> media-provider-idx: 0;
    in property <string> media-provider;
    in property <bool> media-needs-image: false;
    in property <bool> media-needs-mask: false;
    in-out property <string> media-prompt;
    in-out property <string> media-negative-prompt;
    in-out property <string> media-image-url;
    in-out property <string> media-mask-url;
    in-out property <string> media-model;
    in-out property <string> media-aspect-ratio;
    in-out property <string> media-duration;
    in-out property <string> media-seed;
    in-out property <string> media-format;
    // Overrides the provider's default base URL (local installs on a
    // non-default port).
    in-out property <string> media-base-url;
    in property <string> media-status;
    in property <string> media-result-url;
    in property <bool> media-busy: false;
    in property <bool> media-pending: false;
    // ---- video studio (surface mode 3) ----
    in property <[StudioModel]> studio-models;
    in-out property <int> studio-model-idx: 0;
    in property <[StudioTile]> studio-tiles;
    in-out property <string> studio-prompt;
    in-out property <int> studio-quantity: 1;
    in-out property <int> studio-aspect-idx: 0;
    in-out property <int> studio-res-idx: 0;
    in-out property <int> studio-dur-idx: 0;
    in property <bool> studio-busy: false;
    in property <string> studio-status;
    // ---- image studio (surface mode 4) ----
    in property <[string]> image-provider-labels;
    in-out property <int> image-provider-idx: 0;
    in property <string> image-provider;
    in property <[string]> image-sampler-labels;
    in-out property <int> image-sampler-idx: 0;
    in property <[string]> image-scheduler-labels;
    in-out property <int> image-scheduler-idx: 0;
    in property <[ImageLoraRow]> image-loras;
    in property <[ImageTileUi]> image-tiles;
    in-out property <string> image-prompt;
    in-out property <string> image-negative;
    in-out property <string> image-model;
    in-out property <string> image-vae;
    in-out property <int> image-clip-skip: 1;
    in-out property <float> image-steps: 20;
    in-out property <float> image-cfg: 7;
    in-out property <float> image-denoise: 1;
    in-out property <string> image-seed;
    in-out property <int> image-batch: 1;
    in-out property <string> image-width;
    in-out property <string> image-height;
    in-out property <string> image-base-url;
    in property <bool> image-busy: false;
    in property <string> image-status;
    // ---- IDE (three surface modes, like Cursor's composer toggles) ----
    // 0 = Chat, 1 = Agent (input drives the agent loop), 2 = IDE
    // (workspace editor + the agent in a sidebar column).
    in-out property <int> ui-mode: 0;
    in property <string> composer-hint;
    in property <string> workspace-path;
    in property <string> ide-status;
    in property <[TreeRow]> tree-rows;
    in property <string> open-rel;
    in-out property <string> editor-text;
    in-out property <bool> editor-dirty: false;

    // ---- mode rail: traits line in addition to label + blurb ----
    // One entry per mode, same order as pmode-labels, summarizing the
    // constraints that actually bind: "tools · subagents · minimal diff".
    in property <[string]> pmode-traits;

    // ---- callbacks ----
    callback send(string);
    callback history-back();
    callback history-forward();
    callback random-prompt();
    callback scroll-to-end();
    callback invoke-agent-done(string); // JSON AgentResult
    callback palette-toggle();
    callback palette-query-changed(string);
    callback palette-execute(string); // arg: PaletteRow.id
    callback palette-move(int);       // arg: index delta (+1/-1)
    callback pmode-selected(int);   // mode index
    callback pmode-mix-toggle(int);  // mode index: add/remove from blend
    callback mix-editor-toggle();
    callback cap-editor-toggle();
    callback cap-toggle(string);     // feature id
    callback perm-editor-toggle();
    callback perm-cycle(string);     // tool name: allow -> ask -> deny
    callback perm-default-cycle();
    callback gen-cap-selected(int); // generative capability index
    callback agent-strategy-selected(int);
    callback agent-run(string);       // instruction text
    callback daemon-add(string, string, string); // name, instruction, interval-seconds
    callback daemon-run(string);       // task id
    callback daemon-toggle(string);    // task id
    callback daemon-remove(string);   // task id
    callback card-load();     // read card-path, attach for prompt assembly
    callback card-clear();
    callback persona-edited(string, string); // name, description
    callback prompt-engine-toggle();
    callback sync-export();
    callback sync-import();
    callback sync-clear();
    callback sync-login(string, string);
    callback sync-logout();
    callback custom-provider-add();
    callback agent-done(string); // JSON AgentResult
    callback custom-provider-remove(string);
    callback new-chat();
    callback open-chat(string);
    callback request-delete(string);
    callback set-connection(int);
    callback set-provider(int);
    callback model-edited(string);
    callback fetch-models();
    callback pick-model(string);
    callback key-edited(string, string);
    callback temperature-edited(float);
    callback sampling-edited(string, string);
    callback system-prompt-edited(string);
    callback thinking-toggled(bool);
    callback compute-selected(int);
    callback cycle-gpu();
    callback cycle-ctx();
    callback local-url-edited(string);
    callback prism-url-edited(string);
    callback prism-token-edited(string);
    callback save-settings();
    // ---- media ----
    callback media-kind-selected(int);
    callback media-provider-selected(int);
    callback media-generate();
    callback media-poll();
    // ---- studio ----
    callback studio-select-model(int);
    callback studio-quantity-step(int); // +1 / -1
    callback studio-generate();
    callback studio-aspect-selected(int);
    callback studio-res-selected(int);
    callback studio-dur-selected(int);
    // ---- image studio ----
    callback image-provider-selected(int);
    callback image-sampler-selected(int);
    callback image-scheduler-selected(int);
    callback image-generate();
    callback image-seed-random();
    callback image-batch-step(int);      // +1 / -1
    callback image-clip-step(int);       // +1 / -1
    callback image-lora-add();
    callback image-lora-remove(int);     // row index
    callback image-lora-name-edited(int, string);
    callback image-lora-weight-edited(int, string);
    // ---- IDE ----
    callback mode-selected(int);       // Chat(0) / Agent(1) / IDE(2)
    callback workspace-open(string);   // workspace root (from the palette query)
    callback workspace-refresh();
    callback tree-open(string);        // relative path of a tree row
    callback editor-changed(string);
    callback editor-save();

    changed connection-idx => { set-connection(self.connection-idx); }
    changed provider-idx => { set-provider(self.provider-idx); }
    changed compute-idx => { compute-selected(self.compute-idx); }
    changed thinking-enabled => { thinking-toggled(self.thinking-enabled); }
    changed temperature => { temperature-edited(self.temperature); }
    changed media-kind-idx => { media-kind-selected(self.media-kind-idx); }
    changed media-provider-idx => { media-provider-selected(self.media-provider-idx); }
    changed image-provider-idx => { image-provider-selected(self.image-provider-idx); }
    changed image-sampler-idx => { image-sampler-selected(self.image-sampler-idx); }
    changed image-scheduler-idx => { image-scheduler-selected(self.image-scheduler-idx); }

    scroll-to-end => {
        list.content-y = list.height - list.content-height;
    }

    HorizontalLayout {
        // ---- mode rail ----
        Rectangle {
            width: 72px;
            background: #101418;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                for pmode[i] in pmode-labels : Rectangle {
                    height: 86px;
                    background: pmode-idx == i ? #1f3130 : transparent;
                    border-width: 1px;
                    // A mixed-in tile gets an amber edge so a blend is
                    // visible without reading the summary line.
                    border-color: pmode-idx == i ? #2f6b4f : (i < pmode-mixed.length && pmode-mixed[i] ? #8a6d2f : #232a31);
                    border-radius: 6px;
                    TouchArea {
                        clicked => { pmode-selected(i); }
                        mouse-cursor: pointer;
                    }
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        Text {
                            text: pmode;
                            color: pmode-idx == i ? #7ee787 : #9fb0bd;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: pmode-blurbs[i];
                            color: #66707a;
                            font-size: 9px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        // Constraints that actually bind in this mode.
                        // Empty string for chat keeps the tile compact.
                        Text {
                            text: i < pmode-traits.length ? pmode-traits[i] : "";
                            color: pmode-idx == i ? #7ee787 : #55606a;
                            font-size: 8px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            font-weight: 700;
                        }
                        // Blend toggle. The primary tile cannot be
                        // un-blended, so it shows a filled dot instead.
                        Rectangle {
                            height: 14px;
                            width: 20px;
                            background: pmode-idx == i ? #2f6b4f : (i < pmode-mixed.length && pmode-mixed[i] ? #8a6d2f : transparent);
                            border-width: 1px;
                            border-color: #3a444d;
                            border-radius: 7px;
                            TouchArea {
                                clicked => { pmode-mix-toggle(i); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: pmode-idx == i ? "●" : (i < pmode-mixed.length && pmode-mixed[i] ? "+" : "○");
                                color: pmode-idx == i ? #bfffdd : #8b95a1;
                                font-size: 9px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ---- chats sidebar ----
        if show-chats : Rectangle {
            width: 230px;
            background: #161b21;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Chats";
                        color: #e8e6e3;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "+"; clicked => { new-chat(); } }
                }
                ListView {
                    for chat in chats : Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1;
                                row-ta := TouchArea {
                                    clicked => { open-chat(chat.id); }
                                    mouse-cursor: pointer;
                                }
                                background: row-ta.has-hover ? #222a33 : transparent;
                                Text {
                                    text: chat.title;
                                    color: row-ta.has-hover ? #ffffff : #cfd8dc;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Button {
                                text: chat.confirming ? "sure?" : "x";
                                clicked => { request-delete(chat.id); }
                            }
                        }
                    }
                }
            }
        }

        // ---- main column ----
        VerticalLayout {
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Button { checkable: true; checked <=> show-chats; text: "Chats"; }
                ComboBox {
                    model: ["Direct", "Prism API"];
                    current-index <=> connection-idx;
                    width: 130px;
                }
                if connection-idx == 0 : ComboBox {
                    model: provider-labels;
                    current-index <=> provider-idx;
                    width: 190px;
                }
                LineEdit {
                    text: model;
                    placeholder-text: model-hint;
                    edited(t) => { model-edited(t); }
                    width: 180px;
                }
                Rectangle { horizontal-stretch: 1; }
                // Surface modes, like Cursor's composer counts: Chat is
                // the plain client, Agent routes the composer into the
                // agent loop, IDE puts the workspace editor beside it.
                Rectangle {
                    width: 352px;
                    HorizontalLayout {
                        spacing: 2px;
                        for m[i] in ["Chat", "Agent", "IDE", "Studio", "Image"] : Rectangle {
                            height: 26px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: m;
                                    color: ui-mode == i ? #bfffdd : #8b95a1;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => { mode-selected(i); }
                                    mouse-cursor: pointer;
                                }
                            }
                            background: ui-mode == i ? #1f3130 : transparent;
                            border-width: 1px;
                            border-color: ui-mode == i ? #2f6b4f : #232a31;
                            border-radius: 4px;
                        }
                    }
                }
                if streaming : Text {
                    text: "…responding";
                    color: #f5d76e;
                    vertical-alignment: center;
                }
                Button { checkable: true; checked <=> show-settings; text: "Settings"; }
            }

            HorizontalLayout {
                spacing: 8px;
                // IDE pane — side-by-side with the agent column; hidden
                // outside IDE mode by the mode condition.
                if ui-mode == 2 : Rectangle {
                    horizontal-stretch: 3;
                    background: #141a20;
                    border-width: 1px;
                    border-color: #232a31;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: workspace-path == "" ? "No workspace — Win: open via palette (Ctrl+K) → Open workspace folder…" : workspace-path;
                                color: #9fb0bd;
                                font-size: 12px;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Refresh";
                                enabled: workspace-path != "";
                                clicked => { workspace-refresh(); }
                            }
                            Button {
                                text: "Save";
                                enabled: editor-dirty && open-rel != "";
                                clicked => { editor-save(); }
                            }
                            Text {
                                text: ide-status;
                                color: #8b95a1;
                                font-size: 11px;
                                width: 200px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                width: 240px;
                                spacing: 4px;
                                Text { text: "Files"; color: #8b95a1; font-size: 11px; }
                                ListView {
                                    for t in tree-rows : Rectangle {
                                        height: 24px;
                                        HorizontalLayout {
                                            padding-left: 8px + t.depth * 14px;
                                            spacing: 4px;
                                            TouchArea {
                                                clicked => { tree-open(t.rel); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: t.isDir ? t.rel + "/" : t.rel;
                                                color: t.isDir ? #82aaff : #cfd8dc;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: open-rel == "" ? "No file open" : open-rel;
                                    color: #cfd8dc;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                TextEdit {
                                    horizontal-stretch: 1;
                                    text <=> editor-text;
                                    enabled: open-rel != "";
                                    edited(t) => { editor-changed(t); }
                                }
                            }
                        }
                    }
                }
                // Agent / chat column: the transcript plus composer. In
                // Chat mode it is the whole surface; in Agent mode the
                // composer routes into the agent loop; in IDE mode it
                // becomes Cursor-style agent sidebar beside the editor.
                // Studio (3) and Image (4) modes replace it with their
                // generation surfaces.
                // (visible:, not if — the root scroll-to-end handler
                // reaches into this layout for `list`.)
                VerticalLayout {
                    visible: ui-mode != 3 && ui-mode != 4;
                    horizontal-stretch: 2;
                    spacing: 4px;
            if transcript.length == 0 : Text {
                text: "Pick a provider in Settings, then say hello.";
                color: #66707a;
                horizontal-alignment: center;
            }

            list := ListView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                for line in transcript : Rectangle {
                    height: line-view.preferred-height;
                    line-view := VerticalLayout {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 4px;
                        if line.role == "user" : Text {
                            text: "You";
                            color: #82aaff;
                            font-weight: 700;
                        }
                        if line.role == "assistant" : Text {
                            text: "Prism";
                            color: #7ee787;
                            font-weight: 700;
                        }
                        if line.thinking != "" : VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Thinking";
                                color: #8b95a1;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Text {
                                text: line.thinking;
                                color: #8b95a1;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        if line.content != "" : Text {
                            text: line.content;
                            color: line.role == "system" ? #f0ad4e : #e8e6e3;
                            font-size: line.role == "system" ? 11px : 14px;
                            wrap: word-wrap;
                        }
                        if line.role == "assistant" && line.content == "" && streaming : Text {
                            text: "…";
                            color: #66707a;
                        }
                        Rectangle {
                            height: 1px;
                            background: #232a31;
                        }
                    }
                }
            }

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Button {
                    text: "Send";
                    enabled: !streaming && input-text != "";
                    clicked => {
                        send(input-text);
                        input-text = "";
                    }
                }
                Button {
                    text: "Surprise me";
                    enabled: !streaming;
                    clicked => {
                        random-prompt();
                    }
                }
                input-focus := FocusScope {
                    horizontal-stretch: 1;
                    key-pressed(event) => {
                        if event.text == Key.UpArrow {
                            if palette-open {
                                palette-move(-1);
                                return accept;
                            }
                            history-back();
                            return accept;
                        } else if event.text == Key.DownArrow {
                            if palette-open {
                                palette-move(1);
                                return accept;
                            }
                            history-forward();
                            return accept;
                        } else if event.text == Key.Escape && palette-open {
                            palette-toggle();
                            return accept;
                        } else if event.text == Key.Return && input-text != "" && !streaming && !palette-open {
                            send(input-text);
                            input-text = "";
                            return accept;
                        }
                        return reject;
                    }
                    VerticalLayout {
                        LineEdit {
                            text <=> input-text;
                            placeholder-text: composer-hint;
                            enabled: !streaming;
                            accepted(t) => {
                                send(t);
                                input-text = "";
                            }
                        }
                    }
                }
            }
                }

                // ---- video studio surface (mode 3) ----
                // Freepik-style: a linear generation panel beside a
                // workspace grid, in the studio purple no other surface
                // uses. State lives in shared/studio.rs.
                if ui-mode == 3 : HorizontalLayout {
                    spacing: 8px;

                    // ---- generation panel ----
                    Rectangle {
                        width: 320px;
                        background: #161616;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text { text: "Video Studio"; color: #ffffff; font-size: 16px; font-weight: 700; }
                                Text { text: "Unrestricted — no credits, no limits."; color: #a3a3a3; font-size: 10px; }

                                Text { text: "Mode"; color: #a3a3a3; font-size: 11px; }
                                ComboBox {
                                    model: ["Text to Video", "Image to Video", "First & Last Frame", "Lip Sync"];
                                }

                                // Model choice as shopping: card list with
                                // vibe thumbnails, spec lines and chips.
                                Text { text: "Model"; color: #a3a3a3; font-size: 11px; }
                                for m[i] in studio-models : Rectangle {
                                    height: 78px;
                                    background: studio-model-idx == i ? #1e1e1e : transparent;
                                    border-width: 1px;
                                    border-color: studio-model-idx == i ? #b026ff : #333333;
                                    border-radius: 8px;
                                    TouchArea {
                                        clicked => { studio-select-model(i); }
                                        mouse-cursor: pointer;
                                    }
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 44px;
                                            background: @linear-gradient(140deg, m.c1, m.c2);
                                            border-radius: 6px;
                                            clip: true;
                                            Text {
                                                text: "▶";
                                                color: rgba(255, 255, 255, 0.85);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: m.name;
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                if m.badge != "" : Rectangle {
                                                    width: badge-t.preferred-width + 10px;
                                                    height: 15px;
                                                    background: m.badge == "New" ? rgba(176, 38, 255, 0.22) : rgba(255, 255, 255, 0.08);
                                                    border-width: 1px;
                                                    border-color: m.badge == "New" ? rgba(176, 38, 255, 0.5) : rgba(255, 255, 255, 0.15);
                                                    border-radius: 7px;
                                                    badge-t := Text {
                                                        text: m.badge;
                                                        color: m.badge == "New" ? #d9b3ff : #a3a3a3;
                                                        font-size: 8px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Text { text: m.spec; color: #a3a3a3; font-size: 10px; }
                                            Text { text: m.features; color: #c084fc; font-size: 9px; }
                                        }
                                        if studio-model-idx == i : Text {
                                            text: "✓";
                                            color: #b026ff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text { text: "Prompt"; color: #a3a3a3; font-size: 11px; }
                                TextEdit {
                                    height: 64px;
                                    text <=> studio-prompt;
                                    placeholder-text: "Describe your video…";
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Quantity"; color: #a3a3a3; font-size: 11px; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                width: 26px;
                                                height: 24px;
                                                background: studio-quantity > 1 ? #1e1e1e : #161616;
                                                border-width: 1px;
                                                border-color: #333333;
                                                border-radius: 6px;
                                                TouchArea {
                                                    enabled: studio-quantity > 1;
                                                    clicked => { studio-quantity-step(-1); }
                                                    mouse-cursor: pointer;
                                                }
                                                Text {
                                                    text: "−";
                                                    color: studio-quantity > 1 ? #ffffff : #555555;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 24px;
                                                background: #1e1e1e;
                                                border-width: 1px;
                                                border-color: #333333;
                                                border-radius: 6px;
                                                Text {
                                                    text: "\{studio-quantity} / 8";
                                                    color: #ffffff;
                                                    font-size: 11px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Rectangle {
                                                width: 26px;
                                                height: 24px;
                                                background: studio-quantity < 8 ? #1e1e1e : #161616;
                                                border-width: 1px;
                                                border-color: #333333;
                                                border-radius: 6px;
                                                TouchArea {
                                                    enabled: studio-quantity < 8;
                                                    clicked => { studio-quantity-step(1); }
                                                    mouse-cursor: pointer;
                                                }
                                                Text {
                                                    text: "+";
                                                    color: studio-quantity < 8 ? #ffffff : #555555;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Aspect"; color: #a3a3a3; font-size: 11px; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            for a[i] in ["16:9", "9:16", "1:1"] : Rectangle {
                                                width: 34px;
                                                height: 24px;
                                                background: studio-aspect-idx == i ? rgba(176, 38, 255, 0.28) : #1e1e1e;
                                                border-width: 1px;
                                                border-color: studio-aspect-idx == i ? #b026ff : #333333;
                                                border-radius: 5px;
                                                TouchArea {
                                                    clicked => { studio-aspect-selected(i); }
                                                    mouse-cursor: pointer;
                                                }
                                                Text {
                                                    text: a;
                                                    color: studio-aspect-idx == i ? #ffffff : #a3a3a3;
                                                    font-size: 9px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Resolution"; color: #a3a3a3; font-size: 11px; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            for r[i] in ["480p", "720p", "1080p"] : Rectangle {
                                                width: 38px;
                                                height: 24px;
                                                background: studio-res-idx == i ? rgba(176, 38, 255, 0.28) : #1e1e1e;
                                                border-width: 1px;
                                                border-color: studio-res-idx == i ? #b026ff : #333333;
                                                border-radius: 5px;
                                                TouchArea {
                                                    clicked => { studio-res-selected(i); }
                                                    mouse-cursor: pointer;
                                                }
                                                Text {
                                                    text: r;
                                                    color: studio-res-idx == i ? #ffffff : #a3a3a3;
                                                    font-size: 9px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Duration"; color: #a3a3a3; font-size: 11px; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            for d[i] in ["5s", "10s"] : Rectangle {
                                                width: 30px;
                                                height: 24px;
                                                background: studio-dur-idx == i ? rgba(176, 38, 255, 0.28) : #1e1e1e;
                                                border-width: 1px;
                                                border-color: studio-dur-idx == i ? #b026ff : #333333;
                                                border-radius: 5px;
                                                TouchArea {
                                                    clicked => { studio-dur-selected(i); }
                                                    mouse-cursor: pointer;
                                                }
                                                Text {
                                                    text: d;
                                                    color: studio-dur-idx == i ? #ffffff : #a3a3a3;
                                                    font-size: 9px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Generate — big, purple, unmissable.
                                Rectangle {
                                    height: 40px;
                                    background: @linear-gradient(90deg, #9d50bb, #6e48aa);
                                    border-radius: 10px;
                                    drop-shadow-blur: 14px;
                                    drop-shadow-color: rgba(176, 38, 255, 0.35);
                                    TouchArea {
                                        enabled: !studio-busy;
                                        clicked => { studio-generate(); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: studio-busy ? "Generating…" : "Generate";
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                if studio-status != "" : Text {
                                    text: studio-status;
                                    color: #a3a3a3;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- workspace ----
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #0d0d0d;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 34px;
                                background: #161616;
                                border-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { text: "Unsorted"; color: #ffffff; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "Labels"; color: #a3a3a3; font-size: 11px; vertical-alignment: center; }
                                    Text { text: "Folders"; color: #a3a3a3; font-size: 11px; vertical-alignment: center; }
                                    Text { text: "Templates"; color: #a3a3a3; font-size: 11px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: studio-busy ? "Rendering…" : "\{studio-tiles.length} clips";
                                        color: #a3a3a3;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Empty state — the floating polaroid stack.
                            if studio-tiles.length == 0 && !studio-busy : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Rectangle {
                                        width: 250px;
                                        height: 180px;
                                        Rectangle {
                                            x: 8px;
                                            y: 26px;
                                            width: 108px;
                                            height: 128px;
                                            background: #ece9e2;
                                            border-radius: 5px;
                                            transform-rotation: -10deg;
                                            drop-shadow-blur: 16px;
                                            drop-shadow-color: rgba(0, 0, 0, 0.5);
                                            Rectangle {
                                                x: 6px;
                                                y: 6px;
                                                width: 96px;
                                                height: 88px;
                                                background: @linear-gradient(140deg, #16233a, #3f6ea8);
                                                border-radius: 3px;
                                                clip: true;
                                                Text {
                                                    text: "▶";
                                                    color: rgba(255, 255, 255, 0.85);
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            x: 134px;
                                            y: 16px;
                                            width: 108px;
                                            height: 128px;
                                            background: #ece9e2;
                                            border-radius: 5px;
                                            transform-rotation: 9deg;
                                            drop-shadow-blur: 16px;
                                            drop-shadow-color: rgba(0, 0, 0, 0.5);
                                            Rectangle {
                                                x: 6px;
                                                y: 6px;
                                                width: 96px;
                                                height: 88px;
                                                background: @linear-gradient(140deg, #3a1626, #b0567f);
                                                border-radius: 3px;
                                                clip: true;
                                                Text {
                                                    text: "▶";
                                                    color: rgba(255, 255, 255, 0.85);
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            x: 66px;
                                            y: 34px;
                                            width: 116px;
                                            height: 136px;
                                            background: #ece9e2;
                                            border-radius: 5px;
                                            transform-rotation: -3deg;
                                            drop-shadow-blur: 20px;
                                            drop-shadow-color: rgba(0, 0, 0, 0.6);
                                            Rectangle {
                                                x: 6px;
                                                y: 6px;
                                                width: 104px;
                                                height: 94px;
                                                background: @linear-gradient(140deg, #2c1b40, #8a4fd0);
                                                border-radius: 3px;
                                                clip: true;
                                                Text {
                                                    text: "▶";
                                                    color: rgba(255, 255, 255, 0.85);
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Text {
                                            x: 212px;
                                            y: 4px;
                                            text: "✦";
                                            color: #b026ff;
                                            font-size: 18px;
                                        }
                                    }
                                    Text {
                                        text: "Empty, for now";
                                        color: #ffffff;
                                        font-size: 24px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Your first creation changes that.";
                                        color: #a3a3a3;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Generating placeholder
                            if studio-busy : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "Rendering your clip…";
                                        color: #b026ff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "The workspace fills as results land.";
                                        color: #a3a3a3;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        width: 180px;
                                        height: 3px;
                                        background: #1e1e1e;
                                        border-radius: 2px;
                                        Rectangle {
                                            width: 70px;
                                            background: #b026ff;
                                            border-radius: 2px;
                                        }
                                    }
                                }
                            }

                            // Results list (newest first)
                            if studio-tiles.length > 0 && !studio-busy : ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;
                                    for t in studio-tiles : TileCard {
                                        tile: t;
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- image studio surface (mode 4) ----
                // ComfyUI-style parameter panel with node sections
                // (Checkpoint / LoRA / Prompt / Sampler / Latent / Seed)
                // over the local backends: the in-process native
                // renderer, an Automatic1111 install, or ComfyUI.
                // State lives in shared/image.rs.
                if ui-mode == 4 : HorizontalLayout {
                    spacing: 8px;

                    // ---- parameter panel (node sections) ----
                    Rectangle {
                        width: 360px;
                        background: #161616;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text { text: "Image Studio"; color: #ffffff; font-size: 16px; font-weight: 700; }
                                Text { text: "Local backends — no cloud, no credits."; color: #a3a3a3; font-size: 10px; }

                                Text { text: "Backend"; color: #a3a3a3; font-size: 11px; }
                                ComboBox {
                                    model: image-provider-labels;
                                    current-index <=> image-provider-idx;
                                }

                                NodeSection {
                                    title: "CHECKPOINT";
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Checkpoint"; color: #8b95a1; font-size: 10px; }
                                        LineEdit { text <=> image-model; placeholder-text: "install default"; }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "VAE"; color: #8b95a1; font-size: 10px; }
                                        LineEdit { text <=> image-vae; placeholder-text: "checkpoint's built-in VAE"; }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "CLIP skip"; color: #8b95a1; font-size: 10px; }
                                        IntStepper {
                                            value <=> image-clip-skip;
                                            min: 1;
                                            max: 12;
                                            changed(d) => { image-clip-step(d); }
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "LORA";
                                    if image-loras.length == 0 : Text {
                                        text: "No adapters attached.";
                                        color: #666666;
                                        font-size: 10px;
                                    }
                                    for l[i] in image-loras : HorizontalLayout {
                                        spacing: 4px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text: l.name;
                                            placeholder-text: "lora name";
                                            edited(t) => { image-lora-name-edited(i, t); }
                                        }
                                        LineEdit {
                                            width: 56px;
                                            text: l.weight;
                                            edited(t) => { image-lora-weight-edited(i, t); }
                                        }
                                        Rectangle {
                                            width: 22px;
                                            background: #1e1e1e;
                                            border-width: 1px;
                                            border-color: #333333;
                                            border-radius: 5px;
                                            TouchArea {
                                                clicked => { image-lora-remove(i); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: "×";
                                                color: #a3a3a3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 24px;
                                        background: #1e1e1e;
                                        border-width: 1px;
                                        border-color: #333333;
                                        border-radius: 6px;
                                        TouchArea {
                                            clicked => { image-lora-add(); }
                                            mouse-cursor: pointer;
                                        }
                                        Text {
                                            text: image-loras.length >= 8 ? "Max 8 adapters" : "+ Add LoRA";
                                            color: #c084fc;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "PROMPT";
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Positive"; color: #8b95a1; font-size: 10px; }
                                        TextEdit {
                                            height: 64px;
                                            text <=> image-prompt;
                                            placeholder-text: "Describe the image…";
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Negative"; color: #8b95a1; font-size: 10px; }
                                        TextEdit {
                                            height: 44px;
                                            text <=> image-negative;
                                            placeholder-text: "What to avoid…";
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "SAMPLER";
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Sampler"; color: #8b95a1; font-size: 10px; }
                                        ComboBox {
                                            model: image-sampler-labels;
                                            current-index <=> image-sampler-idx;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Scheduler"; color: #8b95a1; font-size: 10px; }
                                        ComboBox {
                                            model: image-scheduler-labels;
                                            current-index <=> image-scheduler-idx;
                                        }
                                    }
                                    HorizontalLayout {
                                        Text { text: "Steps"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: round(image-steps); color: #ffffff; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Slider {
                                        minimum: 1;
                                        maximum: 150;
                                        value <=> image-steps;
                                    }
                                    HorizontalLayout {
                                        Text { text: "CFG"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: round(image-cfg * 10) / 10; color: #ffffff; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 30;
                                        value <=> image-cfg;
                                    }
                                    HorizontalLayout {
                                        Text { text: "Denoise"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: round(image-denoise * 100) / 100; color: #ffffff; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 1;
                                        value <=> image-denoise;
                                    }
                                }

                                NodeSection {
                                    title: "LATENT";
                                    HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Width"; color: #8b95a1; font-size: 10px; }
                                            LineEdit { text <=> image-width; placeholder-text: "512"; }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Height"; color: #8b95a1; font-size: 10px; }
                                            LineEdit { text <=> image-height; placeholder-text: "512"; }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Batch"; color: #8b95a1; font-size: 10px; }
                                        IntStepper {
                                            value <=> image-batch;
                                            min: 1;
                                            max: 8;
                                            changed(d) => { image-batch-step(d); }
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "SEED";
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text <=> image-seed;
                                            placeholder-text: "random";
                                        }
                                        Rectangle {
                                            width: 30px;
                                            background: #1e1e1e;
                                            border-width: 1px;
                                            border-color: #333333;
                                            border-radius: 6px;
                                            TouchArea {
                                                clicked => { image-seed-random(); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: "🎲";
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if image-provider != "native" : VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Base URL"; color: #8b95a1; font-size: 10px; }
                                        LineEdit {
                                            text <=> image-base-url;
                                            placeholder-text: image-provider == "a1111" ? "http://127.0.0.1:7860" : "http://127.0.0.1:8188";
                                        }
                                    }
                                }

                                // Generate — big, purple, unmissable.
                                Rectangle {
                                    height: 40px;
                                    background: @linear-gradient(90deg, #9d50bb, #6e48aa);
                                    border-radius: 10px;
                                    drop-shadow-blur: 14px;
                                    drop-shadow-color: rgba(176, 38, 255, 0.35);
                                    TouchArea {
                                        enabled: !image-busy;
                                        clicked => { image-generate(); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: image-busy ? "Generating…" : "Generate";
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                if image-status != "" : Text {
                                    text: image-status;
                                    color: #a3a3a3;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- output grid ----
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #0d0d0d;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 34px;
                                background: #161616;
                                border-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { text: "Output"; color: #ffffff; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: image-busy ? "Rendering…" : "\{image-tiles.length} images";
                                        color: #a3a3a3;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Empty state.
                            if image-tiles.length == 0 && !image-busy : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "No images yet";
                                        color: #ffffff;
                                        font-size: 22px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Pick a backend, write a prompt, and Generate.";
                                        color: #a3a3a3;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Generating placeholder.
                            if image-busy : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "Sampling…";
                                        color: #b026ff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Images land here as the backend finishes.";
                                        color: #a3a3a3;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        width: 180px;
                                        height: 3px;
                                        background: #1e1e1e;
                                        border-radius: 2px;
                                        Rectangle {
                                            width: 70px;
                                            background: #b026ff;
                                            border-radius: 2px;
                                        }
                                    }
                                }
                            }

                            // Results (newest first).
                            if image-tiles.length > 0 && !image-busy : ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;
                                    for t in image-tiles : Rectangle {
                                        height: 264px;
                                        background: #161616;
                                        border-width: 1px;
                                        border-color: #333333;
                                        border-radius: 8px;
                                        clip: true;
                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 4px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                background: #0d0d0d;
                                                border-radius: 6px;
                                                clip: true;
                                                Image {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    source: t.image;
                                                    image-fit: contain;
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: t.label;
                                                    color: #c084fc;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                if t.url != "" : Text {
                                                    text: t.url;
                                                    color: #7fb3d5;
                                                    font-size: 9px;
                                                    overflow: elide;
                                                    width: 220px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
        }
            }

        // ---- settings panel ----
        if show-settings : Rectangle {
            width: 380px;
            background: #161b21;
            ScrollView {
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Text { text: "Settings"; color: #e8e6e3; font-size: 17px; font-weight: 700; }

                    Text { text: "Connection"; color: #9fb0bd; font-weight: 700; }
                    if connection-idx == 1 : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Server URL"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text: prism-url;
                            edited(t) => { prism-url-edited(t); }
                        }
                        Text { text: "JWT token"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text: prism-token;
                            input-type: password;
                            edited(t) => { prism-token-edited(t); }
                        }
                    }

                    if connection-idx == 0 : VerticalLayout {
                        spacing: 8px;

                        Text { text: "Provider & model"; color: #9fb0bd; font-weight: 700; }
                        Text { text: "Model (empty = provider default)"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text: model;
                            placeholder-text: model-hint;
                            edited(t) => { model-edited(t); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Fetch models"; clicked => { fetch-models(); } }
                            Text { text: models-status; color: #8b95a1; font-size: 11px; vertical-alignment: center; }
                        }
                        if cached-models.length > 0 : VerticalLayout {
                            spacing: 2px;
                            Text { text: "Cached models (click to use)"; color: #8b95a1; font-size: 12px; }
                            for m in cached-models : Rectangle {
                                height: 24px;
                                m-ta := TouchArea {
                                    clicked => { pick-model(m); }
                                    mouse-cursor: pointer;
                                }
                                background: m-ta.has-hover ? #222a33 : transparent;
                                Text { text: m; color: #cfd8dc; font-size: 12px; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        if provider == "ollama" : VerticalLayout {
                            spacing: 4px;
                            Text { text: "Ollama URL"; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text: local-url;
                                edited(t) => { local-url-edited(t); }
                            }
                        }

                        Text { text: "API keys"; color: #9fb0bd; font-weight: 700; }
                        for k in api-keys : VerticalLayout {
                            spacing: 2px;
                            Text { text: k.label; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text: k.key;
                                input-type: password;
                                edited(t) => { key-edited(k.provider, t); }
                            }
                        }
                        Text {
                            text: "Keys are stored in plaintext, like the extension.";
                            color: #66707a;
                            font-size: 11px;
                        }

                        Text { text: "Sampling"; color: #9fb0bd; font-weight: 700; }
                        Text { text: "Temperature"; color: #8b95a1; font-size: 12px; }
                        Slider {
                            minimum: 0;
                            maximum: 2;
                            value <=> temperature;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Max tokens"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: max-tokens; edited(t) => { sampling-edited("max-tokens", t); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Top P"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: top-p; edited(t) => { sampling-edited("top-p", t); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Frequency penalty"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: freq-penalty; edited(t) => { sampling-edited("freq", t); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Presence penalty"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: pres-penalty; edited(t) => { sampling-edited("pres", t); } }
                            }
                        }
                        Text {
                            text: "Empty = omit (server default).";
                            color: #66707a;
                            font-size: 11px;
                        }

                        Text { text: "System prompt"; color: #9fb0bd; font-weight: 700; }
                        TextEdit {
                            height: 90px;
                            text: system-prompt;
                            edited(t) => { system-prompt-edited(t); }
                        }

                        CheckBox {
                            text: "Reason in <thinking> tags first";
                            checked <=> thinking-enabled;
                        }
                        Text {
                            text: "Shown above the answer.";
                            color: #66707a;
                            font-size: 11px;
                        }

                        Text { text: "Hardware"; color: #9fb0bd; font-weight: 700; }
                        Text { text: "Preferred compute"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: compute-labels;
                            current-index <=> compute-idx;
                        }
                        Button { text: gpu-label; clicked => { cycle-gpu(); } }
                        Button { text: ctx-label; clicked => { cycle-ctx(); } }
                        Text {
                            text: "Applied via Ollama's native /api/chat when set; llama.cpp/KoboldCpp take these as launch flags.";
                            color: #66707a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Save settings"; clicked => { save-settings(); } }
                        Text { text: settings-status; color: #8b95a1; font-size: 11px; vertical-alignment: center; }
                    }

                    Text { text: "Custom providers"; color: #9fb0bd; font-weight: 700; }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Add (id, alias, base URL)"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text <=> new-provider-id;
                            placeholder-text: "id (e.g. my-proxy)";
                        }
                        ComboBox {
                            model: canonical-labels;
                            current-index <=> new-provider-canonical-idx;
                        }
                        LineEdit {
                            text <=> new-provider-url;
                            placeholder-text: "https://host/v1";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Add provider";
                                clicked => { custom-provider-add(); }
                            }
                        }
                        for kv in custom-provider-rows : Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: kv.label; color: #cfd8dc; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Button { text: "x"; clicked => { custom-provider-remove(kv.id); } }
                            }
                        }
                    }


                    // ---- character cards (SillyTavern-style) ----
                    Text { text: "Character"; color: #9fb0bd; font-weight: 700; }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Load a V2/V1 character card (JSON). The core assembles the prompt with macros + lore.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> card-path;
                            placeholder-text: "/path/to/character-card.json";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Load card"; clicked => { card-load(); } }
                            Button { text: "Clear"; clicked => { card-clear(); } }
                        }
                        if card-loaded : Text {
                            text: card-summary;
                            color: #7ee787;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text { text: "Persona (your character)"; color: #8b95a1; font-size: 11px; }
                        LineEdit {
                            text <=> persona-name;
                            placeholder-text: "Name";
                            edited(t) => { persona-edited(t, persona-desc); }
                        }
                        LineEdit {
                            text <=> persona-desc;
                            placeholder-text: "Description";
                            edited(t) => { persona-edited(persona-name, t); }
                        }
                        CheckBox {
                            text: "Use the core prompt engine";
                            checked <=> prompt-engine-on;
                            toggled => { prompt-engine-toggle(); }
                        }
                    }

                    // ---- mode mixing / capability / permission editors ----
                    // These are the same contract the core defines: a
                    // blend of modes, per-feature overrides, and the
                    // per-tool policy.
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Mode & capabilities"; color: #9fb0bd; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Blend"; clicked => { mix-editor-toggle(); } }
                            Button { text: "Capabilities"; clicked => { cap-editor-toggle(); } }
                            Button { text: "Permissions"; clicked => { perm-editor-toggle(); } }
                        }
                        Text {
                            text: pmode-blend-summary;
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    if show-cap-editor : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Capabilities"; color: #7ee787; font-weight: 700; }
                        for cap in cap-rows : Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: cap.group;
                                    color: #66707a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    width: 18px;
                                }
                                Text {
                                    text: cap.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    clicked => { cap-toggle(cap.id); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    if show-perm-editor : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Permissions"; color: #7ee787; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "default: " + perm-default;
                                color: #8b95a1;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button { text: "Cycle"; clicked => { perm-default-cycle(); } }
                        }
                        for perm in perm-rows : Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: perm.group;
                                    color: #66707a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    width: 42px;
                                }
                                Text {
                                    text: perm.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    clicked => { perm-cycle(perm.title); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    // ---- agent mode: tools are gated by permissions on
                    //      the core side; the surface picks strategy + task
                    if mode-tools : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Agent"; color: #9fb0bd; font-weight: 700; }
                        ComboBox {
                            model: ["ReAct", "Plan & execute"];
                            current-index <=> agent-strategy-idx;
                        }
                        TextEdit {
                            height: 60px;
                            text <=> agent-task;
                            placeholder-text: "Task for the agent (tools available)";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: agent-busy ? "Running…" : "Run agent";
                                enabled: !agent-busy;
                                clicked => { agent-run(agent-task); }
                            }
                        }
                        if agent-status != "" : Text {
                            text: agent-status;
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        for step in agent-steps : Rectangle {
                            height: 26px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: step.group;
                                    color: #66707a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: step.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // ---- daemon mode: scheduled tasks on the agent loop ----
                    if mode-tasks : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Daemon tasks"; color: #9fb0bd; font-weight: 700; }
                        LineEdit {
                            text <=> daemon-name;
                            placeholder-text: "Task name";
                        }
                        LineEdit {
                            text <=> daemon-interval;
                            placeholder-text: "Interval seconds (empty = manual)";
                        }
                        TextEdit {
                            height: 50px;
                            text <=> daemon-instruction;
                            placeholder-text: "Instruction the agent runs";
                        }
                        Button {
                            text: "Add task";
                            clicked => { daemon-add(daemon-name, daemon-instruction, daemon-interval); }
                        }
                        for t in daemon-tasks : Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: t.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Button { text: "run"; clicked => { daemon-run(t.id); } }
                                Button { text: "x"; clicked => { daemon-remove(t.id); } }
                            }
                        }
                    }

                    // ---- data sync (portable with extension) ----
                    Text { text: "Data sync"; color: #9fb0bd; font-weight: 700; }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Exchange conversations + prompts with the Prism extension.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if sync-logged-in : HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Signed in"; color: #7ee787; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Sign out"; clicked => { sync-logout(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Export"; clicked => { sync-export(); } }
                            Button { text: "Import"; clicked => { sync-import(); } }
                            Button { text: "Clear local"; clicked => { sync-clear(); } }
                        }
                        Text { text: sync-status; color: #8b95a1; font-size: 11px; wrap: word-wrap; }
                    }

                    // ---- generative mode: media capabilities ----
                    if mode-media : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Capability"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: gen-cap-labels;
                            current-index <=> gen-cap-idx;
                        }
                    }
                    if mode-media : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Capability"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: media-kind-labels;
                            current-index <=> media-kind-idx;
                        }
                        Text { text: "Provider"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: media-provider-labels;
                            current-index <=> media-provider-idx;
                        }
                        Text { text: "Base URL (empty = default)"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text <=> media-base-url;
                            placeholder-text: "http://127.0.0.1:8188";
                        }
                        if media-provider == "comfyui" : Text {
                            text: "ComfyUI: Model = checkpoint (or the AnimateDiff motion module for Video). Inpaint needs a source image and a mask.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text { text: "Prompt"; color: #8b95a1; font-size: 12px; }
                        TextEdit {
                            height: 60px;
                            text <=> media-prompt;
                        }
                        if media-needs-image : VerticalLayout {
                            spacing: 2px;
                            Text { text: "Source image URL"; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text <=> media-image-url;
                                placeholder-text: "https://… or data:image/png;base64,…";
                            }
                        }
                        if media-needs-mask : VerticalLayout {
                            spacing: 2px;
                            Text { text: "Mask image URL"; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text <=> media-mask-url;
                                placeholder-text: "https://… or data:image/png;base64,…";
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Model"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-model; placeholder-text: "provider default"; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Aspect ratio"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-aspect-ratio; placeholder-text: "1:1"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Duration (s)"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-duration; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Seed"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-seed; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Format"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-format; placeholder-text: "png"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: media-busy ? "Working…" : "Generate";
                                enabled: !media-busy;
                                clicked => { media-generate(); }
                            }
                            if media-pending : Button {
                                text: "Check status";
                                clicked => { media-poll(); }
                            }
                        }
                        if media-status != "" : Text {
                            text: media-status;
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if media-result-url != "" : Text {
                            text: media-result-url;
                            color: #7fb3d5;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    // audio / transcribe / OCR capabilities (not media requests)
                    if mode-media : VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Audio / transcription / OCR use the dedicated capability services on the host.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // ---- command palette (Ctrl+K) ----
    if palette-open : Rectangle {
        background: #00000066;
        TouchArea {
            clicked => { palette-toggle(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 60px;
            width: 520px;
            height: 420px;
            background: #161b21;
            border-width: 1px;
            border-color: #2a3440;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                LineEdit {
                    text <=> palette-query;
                    placeholder-text: "Type a command… (Ctrl+K)";
                    edited(t) => {
                        palette-query-changed(t);
                        palette-idx = 0;
                    }
                    accepted(t) => {
                        if palette-results.length > 0 && palette-idx < palette-results.length {
                            palette-execute(palette-results[palette-idx].id);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: #232a31;
                }
                palette-list := ListView {
                    vertical-stretch: 1;
                    for r[i] in palette-results : Rectangle {
                        height: 28px;
                        background: i == palette-idx ? #223040 : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            TouchArea {
                                clicked => { palette-execute(r.id); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: r.title;
                                color: i == palette-idx ? #ffffff : #cfd8dc;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.group;
                                color: #66707a;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "Enter run · Esc close · ↑/↓ select";
                    color: #55606a;
                    font-size: 10px;
                }
            }
        }
    }
}
