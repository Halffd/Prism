// Prism desktop UI (Slint). State lives in Rust (prism-core + main.rs);
// this file is presentation only.

import { Button, ComboBox, LineEdit, CheckBox, ListView, ScrollView, Slider, TextEdit } from "std-widgets.slint";

export struct ChatLine {
    role: string,      // "user" | "assistant" | "system"
    content: string,
    thinking: string,  // extracted reasoning; empty = none
    tags: string,      // comma-separated user tags
    read: bool,
    edited: bool,      // the content was edited after it was written
}

export struct ChatRow {
    id: string,
    title: string,
    confirming: bool,  // delete pressed once; second press deletes
    tags: string,      // comma-separated session tags
    unread: bool,
    archived: bool,
}

export struct SearchRow {
    conversation-id: string,
    conversation-title: string,
    message-index: int,
    role: string,
    preview: string,
}

export struct ContextRow {
    id: string,
    kind: string,
    title: string,
    tokens: int,
    enabled: bool,
    source: string,
}

export struct KeyRow {
    provider: string,
    label: string,
    key: string,
}

export struct ProviderRow {
    id: string,
    label: string,
}

export struct PaletteRow {
    id: string,       // dispatch id ("chat.new") or "model:<id>"
    title: string,    // display text
    group: string,    // section label
}

export struct TreeRow {
    rel: string,      // workspace-relative path (shown indented by depth)
    isDir: bool,
    depth: int,
}

// Video studio: a model card is one selectable engine; a tile is one
// finished clip in the workspace grid. Gradient colors are derived in
// Rust from the model's hue (Slint has no hsl()).
export struct StudioModel {
    name: string,
    spec: string,     // "480-4k | 4-30s"
    features: string, // "Reference · Start-End · Audio"
    badge: string,    // "" | "Top pick" | "Fast" | "New"
    c1: color,
    c2: color,
}

export struct StudioTile {
    title: string,
    ratio: string,
    res: string,
    dur: string,
    model: string,
    c1: color,
    c2: color,
    audio: bool,  // the Audio switch was on when it was made
}

// Image studio: one finished image in the result grid (pixels for the
// native renderer / decoded data URLs; `image` is empty for remote
// URL-only tiles), and one LoRA adapter row in the panel.
export struct ImageTileUi {
    image: image,
    label: string,
    url: string,
}

export struct ImageLoraRow {
    name: string,
    weight: string,
}

// Canvas node graph: the same drawing the web studio edits, rendered as
// screen-space rows (the Rust side applies pan and zoom) and sampled wire
// runs (Slint's Path cannot be built from data).
export struct CanvasNodeUi {
    id: int,
    title: string,
    color: color,
    // screen-space box, already panned and zoomed
    x: float, y: float, width: float, height: float, header-h: float,
}

export struct CanvasInkUi {
    // one axis-aligned rectangle of a wire's ink
    x: float, y: float, w: float, h: float,
}

export struct CanvasKnobUi {
    id: string, label: string, control: string, value: string,
    toggle: bool,
}

export struct CanvasLoraUi { name: string, weight: string }

export struct CanvasPaletteUi { kind: string, title: string, color: color }

export struct CanvasComboUi {
    // the knob this combobox drives, plus its choices and which is current
    knob: string,
    values: [string],
    selected-index: int,
}

export struct CanvasAspectUi { ratio: string, selected: bool }

// Image studio: a node-style parameter group (ComfyUI's node bodies).
// `accent` is the node's logic color (model / prompt / sampler);
// `wire` draws the fake graph connector out of the node's bottom.
component NodeSection inherits Rectangle {
    in property <string> title;
    in property <color> accent: #b026ff;
    in property <bool> wire: true;
    background: #141414;
    border-width: 1px;
    border-color: #2c2c2c;
    border-radius: 8px;
    VerticalLayout {
        padding: 8px;
        padding-bottom: wire ? 18px : 8px;
        spacing: 6px;
        Rectangle {
            height: 2px;
            background: accent;
        }
        Text {
            text: title;
            color: accent;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        @children
    }
    if wire : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height;
        width: 2px;
        height: 14px;
        background: #3a2b48;
        Rectangle {
            x: -3px;
            y: parent.height - self.height;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: accent;
        }
    }
}

// A − value + stepper for integer knobs (batch size, CLIP skip).
component IntStepper inherits Rectangle {
    in property <int> value;
    in property <int> min: 1;
    in property <int> max: 8;
    callback changed(int); // +/- 1
    height: 24px;
    HorizontalLayout {
        spacing: 4px;
        Rectangle {
            width: 26px;
            background: value > min ? #1e1e1e : #161616;
            border-width: 1px;
            border-color: #333333;
            border-radius: 6px;
            TouchArea {
                enabled: value > min;
                clicked => { changed(-1); }
                mouse-cursor: pointer;
            }
            Text {
                text: "−";
                color: value > min ? #ffffff : #555555;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: #1e1e1e;
            border-width: 1px;
            border-color: #333333;
            border-radius: 6px;
            Text {
                text: "\{value}";
                color: #ffffff;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            width: 26px;
            background: value < max ? #1e1e1e : #161616;
            border-width: 1px;
            border-color: #333333;
            border-radius: 6px;
            TouchArea {
                enabled: value < max;
                clicked => { changed(1); }
                mouse-cursor: pointer;
            }
            Text {
                text: "+";
                color: value < max ? #ffffff : #555555;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ---- studio tool rail, reference zone and library ----

// One pill in the tool rail. `active` carries the studio purple border and
// wash; the badge (Plugins' "10+ ON") is a plain shop label, never a paywall.
component ToolPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <string> badge: "";
    callback clicked();
    height: 30px;
    accessible-role: button;
    accessible-label: label;
    background: active ? rgba(176, 38, 255, 0.18) : #1a1a1a;
    border-width: 1px;
    border-color: active ? #b026ff : #2c2c2c;
    border-radius: 8px;
    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        Text {
            text: label;
            color: active ? #ffffff : #a3a3a3;
            font-size: 11px;
            font-weight: active ? 700 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if badge != "" : Rectangle {
            width: badge-t.preferred-width + 10px;
            height: 15px;
            background: rgba(176, 38, 255, 0.22);
            border-width: 1px;
            border-color: rgba(176, 38, 255, 0.5);
            border-radius: 7px;
            badge-t := Text {
                text: badge;
                color: #d9b3ff;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// The dashed, magenta-washed visual-reference drop zone. Slint has no
// The dashed, magenta-washed visual-reference drop zone. Slint has no
// `border-style: dashed`, and 1.18's Path has no stroke-dash-array, so the
// dashed edge is built from real elements.
component RefDropZone inherits Rectangle {
    in property <int> count;
    in property <int> max: 50;
    callback add();
    callback clear();
    horizontal-stretch: 1;
    height: 88px;
    // Dashes: Slint 1.18's Path has no stroke-dash-array, so the dashed
    // edge is real elements — one row of tick marks per side, whose count
    // follows the width so the gaps stay even at any size.
    property <int> dash-count: Math.floor((self.width - 32px) / 12px);
    property <brush> dash: drop.has-drag ? #b026ff : rgba(176, 38, 255, 0.45);
    background: @radial-gradient(circle, rgba(176, 38, 255, 0.18), rgba(176, 38, 255, 0.02));
    clip: true;
    // ---- top and bottom edges ----
    Rectangle {
        x: 16px;
        y: 1px;
        width: parent.width - 32px;
        height: 1px;
        HorizontalLayout {
            spacing: 6px;
            for d[i] in dash-count : Rectangle {
                width: 6px;
                height: 1px;
                background: dash;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Rectangle {
        x: 16px;
        y: parent.height - 2px;
        width: parent.width - 32px;
        height: 1px;
        HorizontalLayout {
            spacing: 6px;
            for d[i] in dash-count : Rectangle {
                width: 6px;
                height: 1px;
                background: dash;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    // ---- left and right edges ----
    Rectangle {
        x: 1px;
        y: 16px;
        width: 1px;
        height: parent.height - 32px;
        VerticalLayout {
            spacing: 6px;
            for d[i] in dash-count : Rectangle {
                width: 1px;
                height: 6px;
                background: dash;
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    Rectangle {
        x: parent.width - 2px;
        y: 16px;
        width: 1px;
        height: parent.height - 32px;
        VerticalLayout {
            spacing: 6px;
            for d[i] in dash-count : Rectangle {
                width: 1px;
                height: 6px;
                background: dash;
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: "◈";
            color: #b026ff;
            font-size: 15px;
            horizontal-alignment: center;
        }
        Text {
            text: drop.has-drag ? "Release to add" : "Drop visual references";
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "JPEG / PNG / WEBP · up to 30 MB";
            color: #a3a3a3;
            font-size: 9px;
            horizontal-alignment: center;
        }
    }
    // The counter doubles as the clear button.
    Rectangle {
        x: parent.width - self.width - 6px;
        y: 6px;
        width: clear-t.preferred-width + 12px;
        height: 16px;
        background: rgba(0, 0, 0, 0.45);
        border-width: 1px;
        border-color: #2c2c2c;
        border-radius: 8px;
        TouchArea {
            enabled: count > 0;
            clicked => { root.clear(); }
            mouse-cursor: pointer;
        }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            clear-t := Text {
                text: "\{count} / \{max}";
                color: count > 0 ? #ffffff : #a3a3a3;
                font-size: 9px;
                vertical-alignment: center;
            }
            if count > 0 : Text {
                text: "✕";
                color: #a3a3a3;
                font-size: 8px;
                vertical-alignment: center;
            }
        }
    }
    drop := DropArea {
        width: 100%;
        height: 100%;
        can-drop(event) => { DragAction.copy; }
        dropped(event) => {
            root.add();
            DragAction.copy;
        }
    }
}

// A labelled on/off switch. Small enough for the settings row, where the
// Auto Polish and Audio toggles sit beside the output preset.
component Switch inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback toggled();
    height: 22px;
    HorizontalLayout {
        spacing: 7px;
        Text {
            text: label;
            color: #a3a3a3;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 30px;
            height: 15px;
            border-radius: 8px;
            background: on ? #b026ff : #2a2a2a;
            border-width: 1px;
            border-color: on ? #b026ff : #333333;
            animate background, border-color { duration: 140ms; easing: ease-out; }
            Rectangle {
                x: on ? parent.width - self.width - 2px : 2px;
                width: 9px;
                height: 9px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: on ? #ffffff : #8a8a8a;
                animate x { duration: 140ms; easing: ease-out; }
            }
        }
        TouchArea {
            clicked => { root.toggled(); }
            mouse-cursor: pointer;
        }
    }
}

// A small square glyph button for the prompt toolbar.
component IconChip inherits Rectangle {
    in property <string> glyph;
    in property <string> hint;
    in property <bool> danger: false;
    callback clicked();
    width: 26px;
    height: 24px;
    accessible-role: button;
    accessible-label: hint;
    background: #1e1e1e;
    border-width: 1px;
    border-color: #333333;
    border-radius: 6px;
    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Text {
        text: glyph;
        color: danger ? #d97070 : #a3a3a3;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One tile in the library grid: gradient thumb, spec line, and a hover
// layer that summarises the clip instead of offering actions this build
// cannot perform.
component TileThumb inherits Rectangle {
    in property <StudioTile> tile;
    height: 96px;
    background: #161616;
    border-width: 1px;
    border-color: #2c2c2c;
    border-radius: 8px;
    clip: true;
    VerticalLayout {
        padding: 4px;
        spacing: 4px;
        Rectangle {
            vertical-stretch: 1;
            background: @linear-gradient(140deg, tile.c1, tile.c2);
            border-radius: 5px;
            clip: true;
            Text {
                text: "▶";
                color: rgba(255, 255, 255, 0.85);
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Hover: a glanceable summary, rather than Download /
            // Fullscreen / Delete buttons that would do nothing.
            Rectangle {
                width: 100%;
                height: 100%;
                background: rgba(10, 10, 12, 0.62);
                opacity: ta.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; easing: ease-out; }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: tile.ratio + " · " + tile.res + " · " + tile.dur;
                        color: #ffffff;
                        font-size: 7px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: tile.audio ? "audio on" : "silent";
                        color: tile.audio ? #d9b3ff : #a3a3a3;
                        font-size: 7px;
                        horizontal-alignment: center;
                    }
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
            }
        }
        Text {
            text: tile.title;
            color: #ffffff;
            font-size: 9px;
            overflow: elide;
        }
        Text {
            text: tile.ratio + " · " + tile.res;
            color: #a3a3a3;
            font-size: 8px;
        }
    }
}

export component AppWindow inherits Window {
    title: "Prism";
    preferred-width: 1150px;
    preferred-height: 780px;
    min-width: 720px;
    min-height: 520px;
    background: #101418;

    // ---- state driven from Rust ----
    in property <[ChatLine]> transcript;
    in property <[ChatRow]> chats;
    in property <[string]> provider-labels;
    in property <[KeyRow]> api-keys;
    in property <[string]> cached-models;
    in property <[string]> compute-labels;
    in-out property <int> provider-idx;
    in-out property <int> connection-idx;
    in-out property <int> compute-idx;
    in property <string> provider;
    in property <string> model;
    in property <string> model-hint;
    in-out property <bool> show-chats: true;
    in-out property <bool> show-settings: true;
    in property <bool> streaming;
    in property <string> models-status;
    in property <string> settings-status;
    in property <string> prism-url;
    in property <string> prism-token;
    in property <string> local-url;
    in-out property <float> temperature;
    in property <string> max-tokens;
    in property <string> top-p;
    in property <string> freq-penalty;
    in property <string> pres-penalty;
    in property <string> system-prompt;
    in-out property <bool> thinking-enabled;
    in property <string> gpu-label;
    in property <string> ctx-label;
    in-out property <string> input-text;
    // ---- modes ----
    in-out property <int> pmode-idx: 0;
    in property <bool> mode-tools;
    in property <bool> mode-cards;
    in property <bool> mode-media;
    in property <bool> mode-tasks;
    in property <bool> mode-strategy;
    in-out property <int> gen-cap-idx: 0;
    in property <[string]> pmode-labels;
    in property <[string]> pmode-blurbs;
    in property <[string]> gen-cap-labels;
    // ---- mode mixing ----
    // Which rail tiles are blended into the session (the primary is
    // pmode-idx). A tile can be both primary and mixed.
    in property <[bool]> pmode-mixed;
    in property <string> pmode-blend-summary;
    in property <bool> show-mix-editor;
    // ---- capability editor ----
    in property <[PaletteRow]> cap-rows;
    in property <bool> show-cap-editor;
    // ---- permissions editor ----
    in property <[PaletteRow]> perm-rows;
    in property <bool> show-perm-editor;
    in property <string> perm-default;
    // ---- agent mode ----
    in-out property <int> agent-strategy-idx: 0;
    in-out property <string> agent-task;
    in property <bool> agent-busy;
    in property <string> agent-status;
    in property <[PaletteRow]> agent-steps;
    // ---- daemon mode ----
    in property <[PaletteRow]> daemon-tasks;
    in-out property <string> daemon-name;
    in-out property <string> daemon-instruction;
    in-out property <string> daemon-interval;
    // ---- character cards / persona ----
    in-out property <string> card-path;        // path to a V2/V1 card JSON
    in-out property <string> persona-name;
    in-out property <string> persona-desc;
    in property <bool> card-loaded;
    in property <string> card-summary;         // "Aria · engineer · 2 greetings"
    in-out property <bool> prompt-engine-on: false;
    // ---- data sync ----
    in-out property <string> sync-status;
    in-out property <string> sync-login-email;
    in-out property <string> sync-login-password;
    in property <bool> sync-logged-in;
    // ---- custom providers ----
    in-out property <string> new-provider-id;
    in-out property <int> new-provider-canonical-idx: 0;
    in-out property <string> new-provider-url;
    in property <[string]> canonical-labels;
    in property <[ProviderRow]> custom-provider-rows;
    // ---- command palette ----
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query;
    in property <[PaletteRow]> palette-results;
    in-out property <int> palette-idx: 0;
    // ---- search ----
    in-out property <bool> search-open: false;
    in-out property <string> search-query;
    in-out property <bool> search-regex: false;
    in-out property <bool> search-case-sensitive: false;
    in-out property <int> search-role-idx: 0;    // 0 = any, 1 = user, 2 = assistant, 3 = system
    in-out property <int> search-sort-idx: 0;    // 0 = newest, 1 = oldest, 2 = title
    in-out property <bool> search-unread-only: false;
    in-out property <bool> search-include-archived: false;
    in-out property <string> search-tag;
    in-out property <string> search-file;
    in property <[string]> search-role-labels;
    in property <[string]> search-sort-labels;
    in property <[SearchRow]> search-results;
    in property <string> search-status;
    // ---- research (web / deep / multi / council / debate) ----
    in-out property <bool> show-research: false;
    in-out property <string> research-query;
    in-out property <int> research-provider-idx: 0;
    in-out property <int> research-strategy-idx: 0;
    in property <[string]> research-provider-labels;
    in property <[string]> research-strategy-labels;
    in property <string> research-status;
    in property <string> research-title;
    in property <string> research-body;
    in property <bool> research-busy: false;
    // ---- context management ----
    in property <[ContextRow]> context-items;
    in-out property <string> context-budget: "4000";
    in property <string> context-status;
    // ---- import / export ----
    in-out property <string> backup-path;
    in property <string> backup-status;
    // ---- message editing ----
    in-out property <int> editing-message-index: -1;
    in-out property <string> editing-message-text;
    // ---- session tags ----
    in-out property <string> new-session-tag;
    // ---- media (image / video / 3D) ----
    in property <[string]> media-kind-labels;
    in property <[string]> media-provider-labels;
    in-out property <int> media-kind-idx: 0;
    in-out property <int> media-provider-idx: 0;
    in property <string> media-provider;
    in property <bool> media-needs-image: false;
    in property <bool> media-needs-mask: false;
    in-out property <string> media-prompt;
    in-out property <string> media-negative-prompt;
    in-out property <string> media-image-url;
    in-out property <string> media-mask-url;
    in-out property <string> media-model;
    in-out property <string> media-aspect-ratio;
    in-out property <string> media-duration;
    in-out property <string> media-seed;
    in-out property <string> media-format;
    // Overrides the provider's default base URL (local installs on a
    // non-default port).
    in-out property <string> media-base-url;
    in property <string> media-status;
    in property <string> media-result-url;
    in property <bool> media-busy: false;
    in property <bool> media-pending: false;
// ---- video studio (surface mode 3) ----
    in property <[StudioModel]> studio-models;
    in-out property <int> studio-model-idx: 0;
    in property <[StudioTile]> studio-tiles;
    in-out property <string> studio-prompt;
    in-out property <int> studio-quantity: 1;
    in-out property <int> studio-aspect-idx: 0;
    in-out property <int> studio-res-idx: 0;
    in-out property <int> studio-dur-idx: 0;
    in property <bool> studio-busy: false;
    in property <string> studio-status;
    // The library's search-filtered view, so the markup never filters.
    in property <[StudioTile]> studio-visible-tiles;
    in-out property <int> studio-tool: 0;
    in property <int> studio-drawer: 0;      // 0 rail hidden, 1 rail, 2 library
    in-out property <int> studio-refs: 0;
    in-out property <bool> studio-auto-polish: true;
    in-out property <bool> studio-audio-on: true;
    in-out property <string> studio-query;
    in-out property <int> studio-folder: 0;
    in property <[string]> studio-folder-labels;
    in property <[string]> studio-tool-labels;
    in property <string> studio-tool-title;
    in property <[string]> studio-model-labels; // ComboBox needs plain strings
    // Pushed from Rust: the window is narrow, so the rail and the library
    // draw as drawers. Rust reads it from the window size, which keeps the
    // .slint side out of a layout binding loop.
    in property <bool> studio-narrow;
    // ---- image studio (surface mode 4) ----
    in property <[string]> image-provider-labels;
    in-out property <int> image-provider-idx: 0;
    in property <string> image-provider;
    in property <[string]> image-aspect-labels; // latent aspect presets ("16:9")
    in property <[string]> image-sampler-labels;
    in-out property <int> image-sampler-idx: 0;
    in property <[string]> image-scheduler-labels;
    in-out property <int> image-scheduler-idx: 0;
    in property <[ImageLoraRow]> image-loras;
    in property <[ImageTileUi]> image-tiles;
    in-out property <string> image-prompt;
    in-out property <string> image-negative;
    in-out property <string> image-model;
    in-out property <string> image-vae;
    in-out property <int> image-clip-skip: 1;
    in-out property <float> image-steps: 20;
    in-out property <float> image-cfg: 7;
    in-out property <float> image-denoise: 1;
    in-out property <string> image-seed;
    in property <bool> image-seed-locked: false;
    in-out property <int> image-batch: 1;
    in-out property <string> image-width;
    in-out property <string> image-height;
    in-out property <string> image-base-url;
    in property <bool> image-busy: false;
    in property <string> image-status;
    // ---- canvas node graph ----
    in property <[CanvasPaletteUi]> canvas-palette;
    in property <[CanvasNodeUi]> canvas-nodes;
    in property <[CanvasComboUi]> canvas-combos;
    in property <[CanvasAspectUi]> canvas-aspects;
    in property <[CanvasInkUi]> canvas-ink;
    in property <[CanvasKnobUi]> canvas-knobs;
    in property <[CanvasLoraUi]> canvas-loras;
    in property <[ImageTileUi]> canvas-tiles;
    in property <string> canvas-status;
    in property <string> canvas-zoom: "100%";
    in property <bool> canvas-has-selection: false;
    in property <bool> canvas-seed-locked: false;
    in property <bool> canvas-busy: false;
    in property <[string]> canvas-backends;
    in property <int> canvas-provider: 0;
    // ---- IDE (three surface modes, like Cursor's composer toggles) ----
    // 0 = Chat, 1 = Agent (input drives the agent loop), 2 = IDE
    // (workspace editor + the agent in a sidebar column).
    in-out property <int> ui-mode: 0;
    in property <string> composer-hint;
    in property <string> workspace-path;
    in property <string> ide-status;
    in property <[TreeRow]> tree-rows;
    in property <string> open-rel;
    in-out property <string> editor-text;
    in-out property <bool> editor-dirty: false;

    // ---- mode rail: traits line in addition to label + blurb ----
    // One entry per mode, same order as pmode-labels, summarizing the
    // constraints that actually bind: "tools · subagents · minimal diff".
    in property <[string]> pmode-traits;

    // ---- callbacks ----
    callback send(string);
    callback history-back();
    callback history-forward();
    callback random-prompt();
    callback scroll-to-end();
    callback invoke-agent-done(string); // JSON AgentResult
    callback palette-toggle();
    callback palette-query-changed(string);
    callback palette-execute(string); // arg: PaletteRow.id
    callback palette-move(int);       // arg: index delta (+1/-1)
    callback pmode-selected(int);   // mode index
    callback pmode-mix-toggle(int);  // mode index: add/remove from blend
    callback mix-editor-toggle();
    callback cap-editor-toggle();
    callback cap-toggle(string);     // feature id
    callback perm-editor-toggle();
    callback perm-cycle(string);     // tool name: allow -> ask -> deny
    callback perm-default-cycle();
    callback gen-cap-selected(int); // generative capability index
    callback agent-strategy-selected(int);
    callback agent-run(string);       // instruction text
    callback daemon-add(string, string, string); // name, instruction, interval-seconds
    callback daemon-run(string);       // task id
    callback daemon-toggle(string);    // task id
    callback daemon-remove(string);   // task id
    callback card-load();     // read card-path, attach for prompt assembly
    callback card-clear();
    callback persona-edited(string, string); // name, description
    callback prompt-engine-toggle();
    callback sync-export();
    callback sync-import();
    callback sync-clear();
    callback sync-login(string, string);
    callback sync-logout();
    callback custom-provider-add();
    callback agent-done(string); // JSON AgentResult
    callback custom-provider-remove(string);
    callback new-chat();
    callback open-chat(string);
    callback request-delete(string);
    callback set-connection(int);
    callback set-provider(int);
    callback model-edited(string);
    callback fetch-models();
    callback pick-model(string);
    callback key-edited(string, string);
    callback temperature-edited(float);
    callback sampling-edited(string, string);
    callback system-prompt-edited(string);
    callback thinking-toggled(bool);
    callback compute-selected(int);
    callback cycle-gpu();
    callback cycle-ctx();
    callback local-url-edited(string);
    callback prism-url-edited(string);
    callback prism-token-edited(string);
    callback save-settings();
    // ---- media ----
    callback media-kind-selected(int);
    callback media-provider-selected(int);
    callback media-generate();
    callback media-poll();
    // ---- studio ----
    callback studio-select-model(int);
    callback studio-quantity-step(int); // +1 / -1
    callback studio-generate();
    callback studio-aspect-selected(int);
    callback studio-res-selected(int);
    callback studio-dur-selected(int);
    // ---- studio: tool rail, references, drawers ----
    callback studio-select-tool(int);   // which tool pill
    callback studio-set-drawer(int);    // 0 none, 1 rail, 2 library
    callback studio-ref-add(int);       // drop N reference files
    callback studio-refs-clear();
    callback studio-auto-polish-toggle();
    callback studio-audio-toggle();
    callback studio-query-edited(string);
    callback studio-select-folder(int);
    callback studio-tiles-clear();
    // ---- image studio ----
    callback image-provider-selected(int);
    callback image-sampler-selected(int);
    callback image-scheduler-selected(int);
    callback image-generate();
    callback image-seed-random();
    callback image-seed-lock-toggle();
    callback image-aspect-selected(string); // aspect label, e.g. "16:9"
    callback image-batch-step(int);      // +1 / -1
    callback image-clip-step(int);       // +1 / -1
    callback image-lora-add();
    callback image-lora-remove(int);     // row index
    callback image-lora-name-edited(int, string);
    callback image-lora-weight-edited(int, string);
    // ---- canvas node graph ----
    // One pointer gesture: 1 press, 2 move, 3 release.
    callback canvas-pointer(int, float, float);
    callback canvas-zoom-at(float, float, float);   // pivot x/y, wheel delta
    callback canvas-add-node(string);            // node kind from the palette
    callback canvas-knob-edited(string, string); // knob id, new value
    callback canvas-aspect(string);              // "16:9" etc.
    callback canvas-lora-edited(int, string, string);
    callback canvas-lora-add();
    callback canvas-lora-remove(int);
    callback canvas-seed-roll();
    callback canvas-seed-lock-toggle();
    callback canvas-delete-selected();
    callback canvas-backend(string);         // the chosen backend's label
    callback canvas-generate();
    callback canvas-save();
    // ---- IDE ----
    callback mode-selected(int);       // Chat(0) / Agent(1) / IDE(2)
    callback workspace-open(string);   // workspace root (from the palette query)
    callback workspace-refresh();
    callback tree-open(string);        // relative path of a tree row
    callback editor-changed(string);
    callback editor-save();
    // ---- research ----
    callback research-toggle();
    callback research-run(string);      // "web" | "deep" | "multi" | "council" | "debate"
    // ---- search ----
    callback search-toggle();
    callback search-run();
    callback search-jump(string, int);  // conversation id, message index
    // ---- message actions ----
    callback message-fork(int);          // message index
    callback message-edit-start(int);
    callback message-edit-commit(int, string);
    callback message-edit-cancel();
    callback message-toggle-read(int);
    callback message-tag(int, string);
    callback message-untag(int, string);
    // ---- session actions ----
    callback session-toggle-read(string);
    callback session-toggle-archive(string);
    callback session-tag(string, string);
    callback session-untag(string, string);
    // ---- context ----
    callback context-toggle(string, bool);
    callback context-remove(string);
    callback context-budget-changed(string);
    // ---- import / export ----
    callback backup-export(string);       // path
    callback backup-import(string);       // path

    changed connection-idx => { set-connection(self.connection-idx); }
    changed provider-idx => { set-provider(self.provider-idx); }
    changed compute-idx => { compute-selected(self.compute-idx); }
    changed thinking-enabled => { thinking-toggled(self.thinking-enabled); }
    changed temperature => { temperature-edited(self.temperature); }
    changed media-kind-idx => { media-kind-selected(self.media-kind-idx); }
    changed media-provider-idx => { media-provider-selected(self.media-provider-idx); }
    changed image-provider-idx => { image-provider-selected(self.image-provider-idx); }
    changed image-sampler-idx => { image-sampler-selected(self.image-sampler-idx); }
    changed image-scheduler-idx => { image-scheduler-selected(self.image-scheduler-idx); }

    scroll-to-end => {
        list.content-y = list.height - list.content-height;
    }

    HorizontalLayout {
        // ---- mode rail ----
        Rectangle {
            width: 72px;
            background: #101418;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                for pmode[i] in pmode-labels : Rectangle {
                    height: 86px;
                    background: pmode-idx == i ? #1f3130 : transparent;
                    border-width: 1px;
                    // A mixed-in tile gets an amber edge so a blend is
                    // visible without reading the summary line.
                    border-color: pmode-idx == i ? #2f6b4f : (i < pmode-mixed.length && pmode-mixed[i] ? #8a6d2f : #232a31);
                    border-radius: 6px;
                    TouchArea {
                        clicked => { pmode-selected(i); }
                        mouse-cursor: pointer;
                    }
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        Text {
                            text: pmode;
                            color: pmode-idx == i ? #7ee787 : #9fb0bd;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: pmode-blurbs[i];
                            color: #66707a;
                            font-size: 9px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        // Constraints that actually bind in this mode.
                        // Empty string for chat keeps the tile compact.
                        Text {
                            text: i < pmode-traits.length ? pmode-traits[i] : "";
                            color: pmode-idx == i ? #7ee787 : #55606a;
                            font-size: 8px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            font-weight: 700;
                        }
                        // Blend toggle. The primary tile cannot be
                        // un-blended, so it shows a filled dot instead.
                        Rectangle {
                            height: 14px;
                            width: 20px;
                            background: pmode-idx == i ? #2f6b4f : (i < pmode-mixed.length && pmode-mixed[i] ? #8a6d2f : transparent);
                            border-width: 1px;
                            border-color: #3a444d;
                            border-radius: 7px;
                            TouchArea {
                                clicked => { pmode-mix-toggle(i); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: pmode-idx == i ? "●" : (i < pmode-mixed.length && pmode-mixed[i] ? "+" : "○");
                                color: pmode-idx == i ? #bfffdd : #8b95a1;
                                font-size: 9px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ---- chats sidebar ----
        if show-chats : Rectangle {
            width: 230px;
            background: #161b21;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Chats";
                        color: #e8e6e3;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "+"; clicked => { new-chat(); } }
                }
                ListView {
                    for chat in chats : Rectangle {
                        height: 44px;
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    row-ta := TouchArea {
                                        clicked => { open-chat(chat.id); }
                                        mouse-cursor: pointer;
                                    }
                                    background: row-ta.has-hover ? #222a33 : transparent;
                                    HorizontalLayout {
                                        padding-left: 2px;
                                        spacing: 4px;
                                        Text {
                                            text: chat.unread ? "● " : "";
                                            color: #82aaff;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: chat.archived ? "[archived] " + chat.title : chat.title;
                                            color: row-ta.has-hover ? #ffffff : (chat.archived ? #66707a : #cfd8dc);
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                Button {
                                    text: chat.confirming ? "sure?" : "x";
                                    clicked => { request-delete(chat.id); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 3px;
                                height: 16px;
                                Button {
                                    text: chat.unread ? "Read" : "Unread";
                                    height: 16px;
                                    clicked => { session-toggle-read(chat.id); }
                                }
                                Button {
                                    text: chat.archived ? "Unarchive" : "Archive";
                                    height: 16px;
                                    clicked => { session-toggle-archive(chat.id); }
                                }
                                Text {
                                    text: chat.tags;
                                    color: #8b95a1;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- main column ----
        VerticalLayout {
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Button { checkable: true; checked <=> show-chats; text: "Chats"; }
                ComboBox {
                    model: ["Direct", "Prism API"];
                    current-index <=> connection-idx;
                    width: 130px;
                }
                if connection-idx == 0 : ComboBox {
                    model: provider-labels;
                    current-index <=> provider-idx;
                    width: 190px;
                }
                LineEdit {
                    text: model;
                    placeholder-text: model-hint;
                    edited(t) => { model-edited(t); }
                    width: 180px;
                }
                Rectangle { horizontal-stretch: 1; }
                // Surface modes: Chat is
                // the plain client, Agent routes the composer into the
                // agent loop, IDE puts the workspace editor beside it.
                Rectangle {
                    width: 352px;
                    HorizontalLayout {
                        spacing: 2px;
                        for m[i] in ["Chat", "Agent", "IDE", "Studio", "Image", "Canvas"] : Rectangle {
                            height: 26px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: m;
                                    color: ui-mode == i ? #bfffdd : #8b95a1;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => { mode-selected(i); }
                                    mouse-cursor: pointer;
                                }
                            }
                            background: ui-mode == i ? #1f3130 : transparent;
                            border-width: 1px;
                            border-color: ui-mode == i ? #2f6b4f : #232a31;
                            border-radius: 4px;
                        }
                    }
                }
                if streaming : Text {
                    text: "…responding";
                    color: #f5d76e;
                    vertical-alignment: center;
                }
                Button {
                    text: "Search";
                    clicked => { search-toggle(); }
                }
                Button {
                    text: "Research";
                    clicked => { research-toggle(); }
                }
                Button { checkable: true; checked <=> show-settings; text: "Settings"; }
            }

            HorizontalLayout {
                spacing: 8px;
                // IDE pane — side-by-side with the agent column; hidden
                // outside IDE mode by the mode condition.
                if ui-mode == 2 : Rectangle {
                    horizontal-stretch: 3;
                    background: #141a20;
                    border-width: 1px;
                    border-color: #232a31;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: workspace-path == "" ? "No workspace — Win: open via palette (Ctrl+K) → Open workspace folder…" : workspace-path;
                                color: #9fb0bd;
                                font-size: 12px;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Refresh";
                                enabled: workspace-path != "";
                                clicked => { workspace-refresh(); }
                            }
                            Button {
                                text: "Save";
                                enabled: editor-dirty && open-rel != "";
                                clicked => { editor-save(); }
                            }
                            Text {
                                text: ide-status;
                                color: #8b95a1;
                                font-size: 11px;
                                width: 200px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                width: 240px;
                                spacing: 4px;
                                Text { text: "Files"; color: #8b95a1; font-size: 11px; }
                                ListView {
                                    for t in tree-rows : Rectangle {
                                        height: 24px;
                                        HorizontalLayout {
                                            padding-left: 8px + t.depth * 14px;
                                            spacing: 4px;
                                            TouchArea {
                                                clicked => { tree-open(t.rel); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: t.isDir ? t.rel + "/" : t.rel;
                                                color: t.isDir ? #82aaff : #cfd8dc;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: open-rel == "" ? "No file open" : open-rel;
                                    color: #cfd8dc;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                TextEdit {
                                    horizontal-stretch: 1;
                                    text <=> editor-text;
                                    enabled: open-rel != "";
                                    edited(t) => { editor-changed(t); }
                                }
                            }
                        }
                    }
                }
                // Agent / chat column: the transcript plus composer. In
                // Chat mode it is the whole surface; in Agent mode the
                // composer routes into the agent loop; in IDE mode it
// becomes Cursor-style agent sidebar beside the editor.
                // Studio (3) and Image (4) modes replace it with their
                // generation surfaces.
                // (visible:, not if — the root scroll-to-end handler
                // reaches into this layout for `list`.)
                VerticalLayout {
                    visible: ui-mode != 3 && ui-mode != 4;
                    horizontal-stretch: 2;
                    spacing: 4px;
            if transcript.length == 0 : Text {
                text: "Pick a provider in Settings, then say hello.";
                color: #66707a;
                horizontal-alignment: center;
            }

            list := ListView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                for line[i] in transcript : Rectangle {
                    height: line-view.preferred-height;
                    line-view := VerticalLayout {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 4px;
                        if line.role == "user" : Text {
                            text: "You";
                            color: #82aaff;
                            font-weight: 700;
                        }
                        if line.role == "assistant" : Text {
                            text: "Prism";
                            color: #7ee787;
                            font-weight: 700;
                        }
                        if line.thinking != "" : VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Thinking";
                                color: #8b95a1;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Text {
                                text: line.thinking;
                                color: #8b95a1;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        if editing-message-index == i : TextEdit {
                            text <=> editing-message-text;
                            height: 60px;
                            edited(t) => { editing-message-text = t; }
                        }
                        if editing-message-index != i && line.content != "" : Text {
                            text: line.content;
                            color: line.role == "system" ? #f0ad4e : #e8e6e3;
                            font-size: line.role == "system" ? 11px : 14px;
                            wrap: word-wrap;
                        }
                        if line.role == "assistant" && line.content == "" && streaming : Text {
                            text: "…";
                            color: #66707a;
                        }
                        // ---- per-message actions ----
                        HorizontalLayout {
                            spacing: 6px;
                            height: 22px;
                            visible: editing-message-index != i;
                            Button {
                                text: line.read ? "Mark unread" : "Mark read";
                                height: 20px;
                                clicked => { message-toggle-read(i); }
                            }
                            Button {
                                text: "Fork";
                                height: 20px;
                                clicked => { message-fork(i); }
                            }
                            if editing-message-index == i : Button {
                                text: "Save";
                                height: 20px;
                                clicked => { message-edit-commit(i, editing-message-text); }
                            }
                            if editing-message-index != i : Button {
                                text: "Edit";
                                height: 20px;
                                clicked => { message-edit-start(i); }
                            }
                            if editing-message-index == i : Button {
                                text: "Cancel";
                                height: 20px;
                                clicked => { message-edit-cancel(); }
                            }
                            if line.tags != "" : Text {
                                text: line.tags;
                                color: #8b95a1;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            if line.edited : Text {
                                text: "edited";
                                color: #66707a;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: #232a31;
                        }
                    }
                }
            }

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Button {
                    text: "Send";
                    enabled: !streaming && input-text != "";
                    clicked => {
                        send(input-text);
                        input-text = "";
                    }
                }
                Button {
                    text: "Surprise me";
                    enabled: !streaming;
                    clicked => {
                        random-prompt();
                    }
                }
                input-focus := FocusScope {
                    horizontal-stretch: 1;
                    key-pressed(event) => {
                        if event.text == Key.UpArrow {
                            if palette-open {
                                palette-move(-1);
                                return accept;
                            }
                            history-back();
                            return accept;
                        } else if event.text == Key.DownArrow {
                            if palette-open {
                                palette-move(1);
                                return accept;
                            }
                            history-forward();
                            return accept;
                        } else if event.text == Key.Escape && palette-open {
                            palette-toggle();
                            return accept;
                        } else if event.text == Key.Return && input-text != "" && !streaming && !palette-open {
                            send(input-text);
                            input-text = "";
                            return accept;
                        }
                        return reject;
                    }
                    VerticalLayout {
                        LineEdit {
                            text <=> input-text;
                            placeholder-text: composer-hint;
                            enabled: !streaming;
                            accepted(t) => {
                                send(t);
                                input-text = "";
                            }
                        }
                    }
                }
            }
                }

// ---- video studio surface (mode 3) ----
                // Three columns: the tool rail, the workspace and the
                // library, in the studio purple no other surface uses.
                // Below 1024px the outer two become drawers — Slint has no
                // media query, so the width conditional lives here, and a
                // drawer has to be a width animation rather than an
                // overlay, because a layout child's x/y is not ours to set.
                // State lives in shared/studio.rs.
                if ui-mode == 3 : VerticalLayout {
                    spacing: 8px;
                    // ---- narrow top bar: hamburger + library ----
                    if studio-narrow : HorizontalLayout {
                        height: 40px;
                        spacing: 6px;
                        padding-left: 6px;
                        padding-right: 6px;
                        Rectangle {
                            width: 34px;
                            height: 30px;
                            background: #1a1a1a;
                            border-width: 1px;
                            border-color: #2c2c2c;
                            border-radius: 8px;
                            TouchArea {
                                clicked => { studio-set-drawer(studio-drawer == 1 ? 0 : 1); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: "☰";
                                color: #ffffff;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: studio-tool-title;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 76px;
                            height: 30px;
                            background: studio-drawer == 2 ? rgba(176, 38, 255, 0.22) : #1a1a1a;
                            border-width: 1px;
                            border-color: studio-drawer == 2 ? #b026ff : #2c2c2c;
                            border-radius: 8px;
                            TouchArea {
                                clicked => { studio-set-drawer(studio-drawer == 2 ? 0 : 2); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: "Library";
                                color: studio-drawer == 2 ? #ffffff : #a3a3a3;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        // ---- column 1: the tool rail ----
                        Rectangle {
                            width: studio-narrow ? (studio-drawer == 1 ? 300px : 0px) : 196px;
                            clip: true;
                            background: #141416;
                            border-width: 1px;
                            border-color: #2c2c2c;
                            border-radius: 10px;
                            animate width { duration: 220ms; easing: ease-out; }
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 8px;

                                    Rectangle {
                                        height: 26px;
                                        background: #1a1a1a;
                                        border-width: 1px;
                                        border-color: #2c2c2c;
                                        border-radius: 8px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            Text {
                                                text: "Untitled project";
                                                color: #ffffff;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    Text { text: "Agents"; color: #a3a3a3; font-size: 9px; }
                                    ToolPill {
                                        label: "Chat Mode";
                                        active: false;
                                        clicked => { mode-selected(0); }
                                    }
                                    ToolPill {
                                        label: "Director Mode";
                                        active: false;
                                        clicked => { mode-selected(1); }
                                    }

                                    Text { text: "Tools"; color: #a3a3a3; font-size: 9px; }
                                    for t[i] in studio-tool-labels : ToolPill {
                                        label: t;
                                        active: studio-tool == i;
                                        badge: t == "Plugins" ? "10+ ON" : "";
                                        clicked => { studio-select-tool(i); }
                                    }

                                    // Assets and Inspire would need
                                    // surfaces this build has no route to,
                                    // so the rail stops at what works.
                                }
                            }
                        }

                        // ---- column 2: the workspace ----
                        // Hidden while a drawer owns a narrow window, so the
                        // drawer covers it instead of squeezing it.
                        Rectangle {
                            visible: !(studio-narrow && studio-drawer != 0);
                            horizontal-stretch: 1;
                            min-width: 240px;
                            background: #0d0d0d;
                            border-width: 1px;
                            border-color: #2c2c2c;
                            border-radius: 10px;
                            clip: true;
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 8px;

                                    // ---- head: title, hint, model ----
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: studio-tool-title;
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "ⓘ";
                                            color: #8b95a1;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            width: 140px;
                                            height: 22px;
                                            background: #1a1a1a;
                                            border-width: 1px;
                                            border-color: #2c2c2c;
                                            border-radius: 8px;
                                            clip: true;
                                            ComboBox {
                                                model: studio-model-labels;
                                                current-index <=> studio-model-idx;
                                            }
                                        }
                                    }

                                    // ---- visual references ----
                                    RefDropZone {
                                        count: studio-refs;
                                        max: 50;
                                        add => { studio-ref-add(1); }
                                        clear => { studio-refs-clear(); }
                                    }

                                    // ---- prompt ----
                                    Rectangle {
                                        background: #161616;
                                        border-width: 1px;
                                        border-color: #2c2c2c;
                                        border-radius: 10px;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 8px;
                                            Rectangle {
                                                height: 72px;
                                                background: #222226;
                                                border-radius: 8px;
                                                clip: true;
                                                TextEdit {
                                                    text <=> studio-prompt;
                                                    placeholder-text: "Describe what you want…";
                                                }
                                            }
                                            // Toolbar, pinned inside the prompt
                                            // card so it never scrolls away.
                                            HorizontalLayout {
                                                spacing: 6px;
                                                IconChip { glyph: "▣"; hint: "Camera reference"; }
                                                IconChip { glyph: "⊞"; hint: "Grid overlay"; }
                                                IconChip { glyph: "✦"; hint: "Magic wand"; }
                                                IconChip {
                                                    glyph: "✕";
                                                    hint: "Clear prompt";
                                                    danger: true;
                                                    clicked => { studio-prompt = ""; }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Switch {
                                                    label: "Auto Polish";
                                                    on: studio-auto-polish;
                                                    toggled => { studio-auto-polish-toggle(); }
                                                }
                                            }
                                        }
                                    }

                                    // ---- settings: audio + output preset ----
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Switch {
                                            label: "Audio";
                                            on: studio-audio-on;
                                            toggled => { studio-audio-toggle(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            height: 22px;
                                            background: #1e1e1e;
                                            border-width: 1px;
                                            border-color: #2c2c2c;
                                            border-radius: 11px;
                                            HorizontalLayout {
                                                padding-left: 9px;
                                                padding-right: 9px;
                                                spacing: 5px;
                                                Text {
                                                    text: ["16:9", "9:16", "1:1"][studio-aspect-idx];
                                                    color: #ffffff;
                                                    font-size: 9px;
                                                    vertical-alignment: center;
                                                }
                                                Text { text: "·"; color: #555555; font-size: 9px; vertical-alignment: center; }
                                                Text {
                                                    text: ["480p", "720p", "1080p"][studio-res-idx];
                                                    color: #ffffff;
                                                    font-size: 9px;
                                                    vertical-alignment: center;
                                                }
                                                Text { text: "·"; color: #555555; font-size: 9px; vertical-alignment: center; }
                                                Text {
                                                    text: ["5s", "10s"][studio-dur-idx];
                                                    color: #ffffff;
                                                    font-size: 9px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // ---- aspect / resolution / duration ----
                                    // Three labelled pill rows; the preset
                                    // above only reports their result.
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Aspect";
                                            color: #a3a3a3;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                            width: 54px;
                                        }
                                        for a[i] in ["16:9", "9:16", "1:1"] : Rectangle {
                                            height: 22px;
                                            width: 38px;
                                            background: studio-aspect-idx == i ? rgba(176, 38, 255, 0.28) : #1e1e1e;
                                            border-width: 1px;
                                            border-color: studio-aspect-idx == i ? #b026ff : #2c2c2c;
                                            border-radius: 5px;
                                            TouchArea {
                                                clicked => { studio-aspect-selected(i); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: a;
                                                color: studio-aspect-idx == i ? #ffffff : #a3a3a3;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Resolution";
                                            color: #a3a3a3;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                            width: 54px;
                                        }
                                        for r[i] in ["480p", "720p", "1080p"] : Rectangle {
                                            height: 22px;
                                            width: 40px;
                                            background: studio-res-idx == i ? rgba(176, 38, 255, 0.28) : #1e1e1e;
                                            border-width: 1px;
                                            border-color: studio-res-idx == i ? #b026ff : #2c2c2c;
                                            border-radius: 5px;
                                            TouchArea {
                                                clicked => { studio-res-selected(i); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: r;
                                                color: studio-res-idx == i ? #ffffff : #a3a3a3;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Duration";
                                            color: #a3a3a3;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                            width: 54px;
                                        }
                                        for d[i] in ["5s", "10s"] : Rectangle {
                                            height: 22px;
                                            width: 38px;
                                            background: studio-dur-idx == i ? rgba(176, 38, 255, 0.28) : #1e1e1e;
                                            border-width: 1px;
                                            border-color: studio-dur-idx == i ? #b026ff : #2c2c2c;
                                            border-radius: 5px;
                                            TouchArea {
                                                clicked => { studio-dur-selected(i); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: d;
                                                color: studio-dur-idx == i ? #ffffff : #a3a3a3;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }

                                    // ---- quantity + generate ----
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 116px;
                                            height: 40px;
                                            background: #161616;
                                            border-width: 1px;
                                            border-color: #2c2c2c;
                                            border-radius: 10px;
                                            HorizontalLayout {
                                                padding: 5px;
                                                spacing: 5px;
                                                Rectangle {
                                                    width: 30px;
                                                    background: studio-quantity > 1 ? #26262b : #161616;
                                                    border-width: 1px;
                                                    border-color: #2c2c2c;
                                                    border-radius: 6px;
                                                    TouchArea {
                                                        enabled: studio-quantity > 1;
                                                        clicked => { studio-quantity-step(-1); }
                                                        mouse-cursor: pointer;
                                                    }
                                                    Text {
                                                        text: "−";
                                                        color: studio-quantity > 1 ? #ffffff : #555555;
                                                        font-size: 12px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    background: #1e1e1e;
                                                    border-width: 1px;
                                                    border-color: #2c2c2c;
                                                    border-radius: 6px;
                                                    Text {
                                                        text: "\{studio-quantity} / 8";
                                                        color: #ffffff;
                                                        font-size: 11px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 30px;
                                                    background: studio-quantity < 8 ? #26262b : #161616;
                                                    border-width: 1px;
                                                    border-color: #2c2c2c;
                                                    border-radius: 6px;
                                                    TouchArea {
                                                        enabled: studio-quantity < 8;
                                                        clicked => { studio-quantity-step(1); }
                                                        mouse-cursor: pointer;
                                                    }
                                                    Text {
                                                        text: "+";
                                                        color: studio-quantity < 8 ? #ffffff : #555555;
                                                        font-size: 12px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        // Generate — big, purple, and it carries
                                        // no price: there is nothing to buy.
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 40px;
                                            background: @linear-gradient(90deg, #9d50bb, #6e48aa);
                                            border-radius: 10px;
                                            drop-shadow-blur: 14px;
                                            drop-shadow-color: rgba(176, 38, 255, 0.35);
                                            TouchArea {
                                                enabled: !studio-busy;
                                                clicked => { studio-generate(); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: studio-busy ? "Generating…" : "Generate";
                                                color: #ffffff;
                                                font-size: 13px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if studio-status != "" : Text {
                                        text: studio-status;
                                        color: #a3a3a3;
                                        font-size: 9px;
                                        wrap: word-wrap;
                                    }

                                    // ---- footer pills ----
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        height: 28px;
                                        Rectangle {
                                            width: 84px;
                                            height: 26px;
                                            background: #1a1a1a;
                                            border-width: 1px;
                                            border-color: #2c2c2c;
                                            border-radius: 13px;
                                            TouchArea {
                                                clicked => { mode-selected(0); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: "Chat";
                                                color: #ffffff;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            width: 84px;
                                            height: 26px;
                                            background: #1a1a1a;
                                            border-width: 1px;
                                            border-color: #2c2c2c;
                                            border-radius: 13px;
                                            TouchArea {
                                                // On a narrow window the rail is
                                                // a drawer, so this opens it; on
                                                // a wide one the rail is already
                                                // visible, so it returns to the
                                                // primary tool.
                                                clicked => {
                                                    if studio-narrow { studio-set-drawer(1); } else { studio-select-tool(0); }
                                                }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: "Tools";
                                                color: #ffffff;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ---- column 3: the library ----
                        Rectangle {
                            width: studio-narrow ? (studio-drawer == 2 ? 300px : 0px) : 292px;
                            clip: true;
                            background: #101012;
                            border-width: 1px;
                            border-color: #2c2c2c;
                            border-radius: 10px;
                            animate width { duration: 220ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 8px;
                                spacing: 8px;

                                // ---- top bar: folders, search, actions ----
                                HorizontalLayout {
                                    spacing: 5px;
                                    for f[i] in studio-folder-labels : Rectangle {
                                        height: 20px;
                                        width: ft.preferred-width + 12px;
                                        background: studio-folder == i ? rgba(176, 38, 255, 0.22) : #1a1a1a;
                                        border-width: 1px;
                                        border-color: studio-folder == i ? #b026ff : #2c2c2c;
                                        border-radius: 10px;
                                        TouchArea {
                                            clicked => { studio-select-folder(i); }
                                            mouse-cursor: pointer;
                                        }
                                        ft := Text {
                                            text: f;
                                            color: studio-folder == i ? #ffffff : #a3a3a3;
                                            font-size: 9px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        background: #1a1a1a;
                                        border-width: 1px;
                                        border-color: #2c2c2c;
                                        border-radius: 8px;
                                        clip: true;
                                        LineEdit {
                                            text <=> studio-query;
                                            placeholder-text: "Search clips…";
                                            font-size: 10px;
                                            edited(t) => { studio-query-edited(t); }
                                        }
                                    }
                                    IconChip {
                                        glyph: "✕";
                                        hint: "Clear library";
                                        danger: true;
                                        clicked => { studio-tiles-clear(); }
                                    }
                                }

                                // The banner that stands where an upgrade nag
                                // would sit on a metered product.
                                Rectangle {
                                    height: 22px;
                                    background: rgba(176, 38, 255, 0.10);
                                    border-width: 1px;
                                    border-color: rgba(176, 38, 255, 0.28);
                                    border-radius: 11px;
                                    Text {
                                        text: "Unlimited history. No tracking.";
                                        color: #d9b3ff;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    height: 16px;
                                    spacing: 6px;
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: studio-busy ? "Rendering…" : "\{studio-visible-tiles.length} clips";
                                        color: #a3a3a3;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                }

                                // ---- library body ----
                                if studio-busy : GridLayout {
                                    spacing: 6px;
                                    for i in 3 : Rectangle {
                                        row: i / 2;
                                        col: Math.mod(i, 2);
                                        height: 90px;
                                        background: #161616;
                                        border-width: 1px;
                                        border-color: #222226;
                                        border-radius: 8px;
                                        Rectangle {
                                            x: 5px;
                                            y: 5px;
                                            width: parent.width - 10px;
                                            height: parent.height - 24px;
                                            background: #22222a;
                                            border-radius: 5px;
                                            Rectangle {
                                                x: 5px;
                                                y: 5px;
                                                width: 34px;
                                                height: 8px;
                                                background: #2a2a35;
                                                border-radius: 4px;
                                            }
                                        }
                                        Rectangle {
                                            x: 5px;
                                            y: parent.height - 17px;
                                            width: 46px;
                                            height: 6px;
                                            background: #2a2a35;
                                            border-radius: 3px;
                                        }
                                    }
                                }
                                if !studio-busy && studio-visible-tiles.length == 0 && studio-tiles.length > 0 : VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "No matches";
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Nothing matches \"\{studio-query}\".";
                                        color: #a3a3a3;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                    }
                                }
                                if !studio-busy && studio-visible-tiles.length == 0 : Rectangle {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        // The floating polaroid stack.
                                        Rectangle {
                                            width: 230px;
                                            height: 150px;
                                            Rectangle {
                                                x: 6px;
                                                y: 22px;
                                                width: 96px;
                                                height: 118px;
                                                background: #ece9e2;
                                                border-radius: 4px;
                                                transform-rotation: -10deg;
                                                drop-shadow-blur: 14px;
                                                drop-shadow-color: rgba(0, 0, 0, 0.45);
                                                Rectangle {
                                                    x: 5px;
                                                    y: 5px;
                                                    width: 86px;
                                                    height: 82px;
                                                    background: @linear-gradient(140deg, #16233a, #3f6ea8);
                                                    border-radius: 3px;
                                                    clip: true;
                                                    Text {
                                                        text: "▶";
                                                        color: rgba(255, 255, 255, 0.85);
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                x: 128px;
                                                y: 12px;
                                                width: 96px;
                                                height: 118px;
                                                background: #ece9e2;
                                                border-radius: 4px;
                                                transform-rotation: 9deg;
                                                drop-shadow-blur: 14px;
                                                drop-shadow-color: rgba(0, 0, 0, 0.45);
                                                Rectangle {
                                                    x: 5px;
                                                    y: 5px;
                                                    width: 86px;
                                                    height: 82px;
                                                    background: @linear-gradient(140deg, #3a1626, #b0567f);
                                                    border-radius: 3px;
                                                    clip: true;
                                                    Text {
                                                        text: "▶";
                                                        color: rgba(255, 255, 255, 0.85);
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                x: 62px;
                                                y: 30px;
                                                width: 104px;
                                                height: 126px;
                                                background: #ece9e2;
                                                border-radius: 4px;
                                                transform-rotation: -3deg;
                                                drop-shadow-blur: 18px;
                                                drop-shadow-color: rgba(0, 0, 0, 0.55);
                                                Rectangle {
                                                    x: 5px;
                                                    y: 5px;
                                                    width: 94px;
                                                    height: 88px;
                                                    background: @linear-gradient(140deg, #2c1b40, #8a4fd0);
                                                    border-radius: 3px;
                                                    clip: true;
                                                    Text {
                                                        text: "▶";
                                                        color: rgba(255, 255, 255, 0.85);
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Empty, for now";
                                            color: #ffffff;
                                            font-size: 18px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "Your first creation changes that.";
                                            color: #a3a3a3;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                if !studio-busy && studio-visible-tiles.length > 0 : ScrollView {
                                    GridLayout {
                                        spacing: 6px;
                                        for t[i] in studio-visible-tiles : TileThumb {
                                            row: i / 2;
                                            col: Math.mod(i, 2);
                                            tile: t;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

// ---- image studio surface (mode 4) ----
                // ComfyUI-style parameter panel with node sections
                // (Checkpoint / LoRA / Prompt / Sampler / Latent / Seed)
                // over the local backends: the in-process native
                // renderer, an Automatic1111 install, or ComfyUI.
                // State lives in shared/image.rs.
                if ui-mode == 4 : HorizontalLayout {
                    spacing: 8px;

                    // ---- parameter panel (node sections) ----
                    Rectangle {
                        width: 360px;
                        background: #161616;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                Text { text: "Image Studio"; color: #ffffff; font-size: 16px; font-weight: 700; }
                                Text { text: "Local backends — no cloud, no credits."; color: #a3a3a3; font-size: 10px; }

                                Text { text: "Backend"; color: #a3a3a3; font-size: 11px; }
                                ComboBox {
                                    model: image-provider-labels;
                                    current-index <=> image-provider-idx;
                                }

                                NodeSection {
                                    title: "CHECKPOINT";
                                    accent: #b026ff;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Checkpoint"; color: #8b95a1; font-size: 10px; }
                                        LineEdit { text <=> image-model; placeholder-text: "install default"; }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "VAE"; color: #8b95a1; font-size: 10px; }
                                        LineEdit { text <=> image-vae; placeholder-text: "checkpoint's built-in VAE"; }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "CLIP skip"; color: #8b95a1; font-size: 10px; }
                                        IntStepper {
                                            value <=> image-clip-skip;
                                            min: 1;
                                            max: 12;
                                            changed(d) => { image-clip-step(d); }
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "LORA";
                                    accent: #22c55e;
                                    if image-loras.length == 0 : Text {
                                        text: "No adapters attached.";
                                        color: #666666;
                                        font-size: 10px;
                                    }
                                    for l[i] in image-loras : HorizontalLayout {
                                        spacing: 4px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text: l.name;
                                            placeholder-text: "lora name";
                                            edited(t) => { image-lora-name-edited(i, t); }
                                        }
                                        LineEdit {
                                            width: 56px;
                                            text: l.weight;
                                            edited(t) => { image-lora-weight-edited(i, t); }
                                        }
                                        Rectangle {
                                            width: 22px;
                                            background: #1e1e1e;
                                            border-width: 1px;
                                            border-color: #333333;
                                            border-radius: 5px;
                                            TouchArea {
                                                clicked => { image-lora-remove(i); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: "×";
                                                color: #a3a3a3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 24px;
                                        background: #1e1e1e;
                                        border-width: 1px;
                                        border-color: #333333;
                                        border-radius: 6px;
                                        TouchArea {
                                            clicked => { image-lora-add(); }
                                            mouse-cursor: pointer;
                                        }
                                        Text {
                                            text: image-loras.length >= 8 ? "Max 8 adapters" : "+ Add LoRA";
                                            color: #c084fc;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "PROMPT";
                                    accent: #38bdf8;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Positive"; color: #8b95a1; font-size: 10px; }
                                        TextEdit {
                                            height: 64px;
                                            text <=> image-prompt;
                                            placeholder-text: "Describe the image…";
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Negative"; color: #8b95a1; font-size: 10px; }
                                        TextEdit {
                                            height: 44px;
                                            text <=> image-negative;
                                            placeholder-text: "What to avoid…";
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "SAMPLER";
                                    accent: #f59e0b;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Sampler"; color: #8b95a1; font-size: 10px; }
                                        ComboBox {
                                            model: image-sampler-labels;
                                            current-index <=> image-sampler-idx;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Scheduler"; color: #8b95a1; font-size: 10px; }
                                        ComboBox {
                                            model: image-scheduler-labels;
                                            current-index <=> image-scheduler-idx;
                                        }
                                    }
                                    HorizontalLayout {
                                        Text { text: "Steps"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: round(image-steps); color: #ffffff; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Slider {
                                        minimum: 1;
                                        maximum: 150;
                                        value <=> image-steps;
                                    }
                                    HorizontalLayout {
                                        Text { text: "CFG"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: round(image-cfg * 10) / 10; color: #ffffff; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 30;
                                        value <=> image-cfg;
                                    }
                                    HorizontalLayout {
                                        Text { text: "Denoise"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: round(image-denoise * 100) / 100; color: #ffffff; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 1;
                                        value <=> image-denoise;
                                    }
                                }

                                NodeSection {
                                    title: "LATENT";
                                    accent: #06b6d4;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Width"; color: #8b95a1; font-size: 10px; }
                                            LineEdit { text <=> image-width; placeholder-text: "512"; }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: "Height"; color: #8b95a1; font-size: 10px; }
                                            LineEdit { text <=> image-height; placeholder-text: "512"; }
                                        }
                                    }
                                    // Aspect presets write width/height (the Rust helper ignores unknown
// labels, so manual dimensions survive a stray click).
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Text { text: "Aspect"; color: #8b95a1; font-size: 10px; vertical-alignment: center; }
                                        for a in image-aspect-labels : Rectangle {
                                            height: 22px;
                                            min-width: 32px;
                                            background: #1e1e1e;
                                            border-width: 1px;
                                            border-color: #333333;
                                            border-radius: 6px;
                                            TouchArea {
                                                clicked => { image-aspect-selected(a); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: a;
                                                color: #06b6d4;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Batch"; color: #8b95a1; font-size: 10px; }
                                        IntStepper {
                                            value <=> image-batch;
                                            min: 1;
                                            max: 8;
                                            changed(d) => { image-batch-step(d); }
                                        }
                                    }
                                }

                                NodeSection {
                                    title: "SEED";
                                    accent: #f43f5e;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text <=> image-seed;
                                            placeholder-text: "random";
                                        }
                                        Rectangle {
                                            width: 30px;
                                            background: #1e1e1e;
                                            border-width: 1px;
                                            border-color: #333333;
                                            border-radius: 6px;
                                            TouchArea {
                                                enabled: !image-seed-locked;
                                                clicked => { image-seed-random(); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: "🎲";
                                                opacity: image-seed-locked ? 0.35 : 1.0;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            width: 30px;
                                            background: image-seed-locked ? #3b1220 : #1e1e1e;
                                            border-width: 1px;
                                            border-color: image-seed-locked ? #f43f5e : #333333;
                                            border-radius: 6px;
                                            TouchArea {
                                                clicked => { image-seed-lock-toggle(); }
                                                mouse-cursor: pointer;
                                            }
                                            Text {
                                                text: image-seed-locked ? "🔒" : "🔓";
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if image-provider != "native" : VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Base URL"; color: #8b95a1; font-size: 10px; }
                                        LineEdit {
                                            text <=> image-base-url;
                                            placeholder-text: image-provider == "a1111" ? "http://127.0.0.1:7860" : "http://127.0.0.1:8188";
                                        }
                                    }
                                }

                                // Generate — big, purple, unmissable.
                                Rectangle {
                                    height: 40px;
                                    background: @linear-gradient(90deg, #9d50bb, #6e48aa);
                                    border-radius: 10px;
                                    drop-shadow-blur: 14px;
                                    drop-shadow-color: rgba(176, 38, 255, 0.35);
                                    TouchArea {
                                        enabled: !image-busy;
                                        clicked => { image-generate(); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: image-busy ? "Generating…" : "Generate";
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                if image-status != "" : Text {
                                    text: image-status;
                                    color: #a3a3a3;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- output grid ----
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #0d0d0d;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 34px;
                                background: #161616;
                                border-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { text: "Output"; color: #ffffff; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: image-busy ? "Rendering…" : "\{image-tiles.length} images";
                                        color: #a3a3a3;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Empty state.
                            if image-tiles.length == 0 && !image-busy : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "No images yet";
                                        color: #ffffff;
                                        font-size: 22px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Pick a backend, write a prompt, and Generate.";
                                        color: #a3a3a3;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // Generating placeholder.
                            if image-busy : Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "Sampling…";
                                        color: #b026ff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Images land here as the backend finishes.";
                                        color: #a3a3a3;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        width: 180px;
                                        height: 3px;
                                        background: #1e1e1e;
                                        border-radius: 2px;
                                        Rectangle {
                                            width: 70px;
                                            background: #b026ff;
                                            border-radius: 2px;
                                        }
                                    }
                                }
                            }

                            // Results (newest first).
                            if image-tiles.length > 0 && !image-busy : ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;
                                    for t in image-tiles : Rectangle {
                                        height: 264px;
                                        background: #161616;
                                        border-width: 1px;
                                        border-color: #333333;
                                        border-radius: 8px;
                                        clip: true;
                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 4px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                background: #0d0d0d;
                                                border-radius: 6px;
                                                clip: true;
                                                Image {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    source: t.image;
                                                    image-fit: contain;
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    text: t.label;
                                                    color: #c084fc;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                if t.url != "" : Text {
                                                    text: t.url;
                                                    color: #7fb3d5;
                                                    font-size: 9px;
                                                    overflow: elide;
                                                    width: 220px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
        }
                if ui-mode == 5 : HorizontalLayout {
                    spacing: 8px;

                    // ---- palette + inspector ----
                    Rectangle {
                        width: 336px;
                        background: #161616;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Text { text: "Node Studio"; color: #ffffff; font-size: 16px; font-weight: 700; }
                                Text { text: "The same canvas the web studio edits."; color: #a3a3a3; font-size: 10px; }

                                Text { text: "Add node"; color: #a3a3a3; font-size: 11px; }
                                for entry[ei] in canvas-palette : Rectangle {
                                    height: 24px;
                                    border-radius: 6px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: entry.color;
                                        }
                                        Text {
                                            text: entry.title;
                                            color: entry.color;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { canvas-add-node(entry.kind); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                if canvas-has-selection : VerticalLayout {
                                    spacing: 4px;
                                    padding-top: 8px;
                                    Text { text: "Selected node"; color: #a3a3a3; font-size: 11px; }

                                    for knob[ki] in canvas-knobs : VerticalLayout {
                                        spacing: 2px;
                                        Text { text: knob.label; color: #8b95a1; font-size: 10px; }
                                        if knob.toggle : Button {
                                            text: canvas-seed-locked ? "Seed locked" : "Seed unlocked";
                                            clicked => { canvas-seed-lock-toggle(); }
                                        }
                                        if !knob.toggle : LineEdit {
                                            text: knob.value;
                                            placeholder-text: knob.id == "seed" ? "empty = random" : "";
                                            edited(value) => { canvas-knob-edited(knob.id, value); }
                                        }
                                    }

                                    for combo in canvas-combos : ComboBox {
                                        model: combo.values;
                                        current-index: combo.selected-index;
                                        selected(value) => { canvas-knob-edited(combo.knob, value); }
                                    }

                                    // Aspect presets, drawn as buttons because five
                                    // short labels read better than a dropdown.
                                    HorizontalLayout {
                                        visible: canvas-aspects.length > 0;
                                        spacing: 4px;
                                        for preset in canvas-aspects : Rectangle {
                                            width: 36px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: preset.selected ? #b026ff : #232735;
                                            Text {
                                                text: preset.ratio;
                                                color: #ffffff;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => { canvas-aspect(preset.ratio); }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }

                                    if canvas-knobs.length > 0 && canvas-knobs[0].id == "seed" : Button {
                                        text: "Roll seed";
                                        enabled: !canvas-seed-locked;
                                        clicked => { canvas-seed-roll(); }
                                    }

                                    for lora[ro] in canvas-loras : HorizontalLayout {
                                        spacing: 4px;
                                        LineEdit {
                                            width: 150px;
                                            text: lora.name;
                                            placeholder-text: "lora name";
                                            edited(v) => { canvas-lora-edited(ro, v, lora.weight); }
                                        }
                                        LineEdit {
                                            width: 52px;
                                            text: lora.weight;
                                            placeholder-text: "0.8";
                                            edited(v) => { canvas-lora-edited(ro, lora.name, v); }
                                        }
                                        Button {
                                            text: "×";
                                            clicked => { canvas-lora-remove(ro); }
                                        }
                                    }
                                    Button { text: "+ Add LoRA"; clicked => { canvas-lora-add(); } }
                                    Button { text: "Delete node"; clicked => { canvas-delete-selected(); } }
                                }
                            }
                        }
                    }

                    // ---- the canvas ----
                    Rectangle {
                        clip: true;
                        background: #0b0d14;
                        // One gesture handler for the whole canvas: a node's own
                        // knob controls stop propagation, so a click that lands in
                        // a field never also pans the viewport.
                        TouchArea {
                            pointer-event(event) => {
                                // One integer per gesture: 1 press, 2 move,
                                // 3 release. Anything else is a move.
                                if event.kind == PointerEventKind.down {
                                    canvas-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                                if event.kind == PointerEventKind.up {
                                    canvas-pointer(3, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                                if event.kind != PointerEventKind.down && event.kind != PointerEventKind.up {
                                    canvas-pointer(2, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                            scroll-event(event) => {
                                // Zoom about the pointer, so the point under
                                // the cursor is the point that stays put.
                                canvas-zoom-at(self.mouse-x / 1px, self.mouse-y / 1px, event.delta-y / 1px);
                                return accept;
                            }
                            mouse-cursor: crosshair;
                        }
                        // Wires beneath the nodes: the ink of a sampled
                        // polyline of the core's bezier. Slint rotates only
                        // Image and Text, so each run is an axis-dominant
                        // rectangle rather than a rotated one.
                        for ink in canvas-ink : Rectangle {
                            x: ink.x * 1px;
                            y: ink.y * 1px;
                            width: max(2px, ink.w * 1px);
                            height: max(2px, ink.h * 1px);
                            background: #b026ff;
                        }
                        for node[ni] in canvas-nodes : Rectangle {
                            x: node.x * 1px;
                            y: node.y * 1px;
                            width: node.width * 1px;
                            height: node.height * 1px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #2a2f3f;
                            clip: true;
                            background: #12141c;
                            Rectangle {
                                height: node.header-h * 1px;
                                background: node.color;
                                // A layout carries the padding; a bare Text
                                // ignores it.
                                HorizontalLayout {
                                    padding-left: 8px;
                                    Text {
                                        text: node.title;
                                        color: #0b0d14;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            x: 12px;
                            y: 12px;
                            text: canvas-status;
                            color: #8b90a3;
                            font-size: 11px;
                        }
                        Text {
                            x: 12px;
                            y: 30px;
                            text: canvas-zoom;
                            color: #8b90a3;
                            font-size: 11px;
                        }
                    }

                    // ---- output ----
                    Rectangle {
                        width: 264px;
                        background: #161616;
                        border-width: 1px;
                        border-color: #333333;
                        border-radius: 10px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text { text: "Output"; color: #a3a3a3; font-size: 11px; }
                                ComboBox {
                                    model: canvas-backends;
                                    current-index: canvas-provider;
                                    selected(value) => { canvas-backend(value); }
                                }
                                Button {
                                    text: "Generate";
                                    enabled: !canvas-busy;
                                    clicked => { canvas-generate(); }
                                }
                                Button { text: "Save canvas"; clicked => { canvas-save(); } }
                                for tile in canvas-tiles : VerticalLayout {
                                    spacing: 4px;
                                    Image {
                                        source: tile.image;
                                        width: 100%;
                                        height: 120px;
                                        image-fit: contain;
                                    }
                                    Text { text: tile.label; color: #8b90a1; font-size: 10px; }
                                }
                            }
                        }
                    }
                }
            }

        // ---- research panel ----
        // One panel for the whole research pipeline; the core formats
        // the text so the CLI and desktop show identical results.
        if show-research : Rectangle {
            width: 430px;
            background: #161b21;
            border-width: 1px;
            border-color: #232a31;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Research";
                        color: #e8e6e3;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if research-busy : Text {
                        text: "running…";
                        color: #f5d76e;
                        vertical-alignment: center;
                    }
                    Button { text: "Close"; clicked => { research-toggle(); } }
                }
                Text { text: "Search backend"; color: #8b95a1; font-size: 11px; }
                ComboBox {
                    model: research-provider-labels;
                    current-index <=> research-provider-idx;
                }
                Text { text: "Question"; color: #8b95a1; font-size: 11px; }
                LineEdit {
                    text <=> research-query;
                    placeholder-text: "Ask the web, or give the ensemble a prompt";
                    accepted(t) => { research-run("web"); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Button { text: "Web"; clicked => { research-run("web"); } }
                    Button { text: "Deep"; clicked => { research-run("deep"); } }
                    Button { text: "Multi"; clicked => { research-run("multi"); } }
                    Button { text: "Council"; clicked => { research-run("council"); } }
                    Button { text: "Debate"; clicked => { research-run("debate"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Council vote";
                        color: #8b95a1;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: research-strategy-labels;
                        current-index <=> research-strategy-idx;
                    }
                }
                Text {
                    text: research-status;
                    color: #8b95a1;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle { height: 1px; background: #232a31; }
                Text {
                    text: research-title;
                    color: #7ee787;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: #101418;
                    border-radius: 4px;
                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: research-body;
                                color: #cfd8dc;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // ---- settings panel ----
        if show-settings : Rectangle {
            width: 380px;
            background: #161b21;
            ScrollView {
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Text { text: "Settings"; color: #e8e6e3; font-size: 17px; font-weight: 700; }

                    Text { text: "Connection"; color: #9fb0bd; font-weight: 700; }
                    if connection-idx == 1 : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Server URL"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text: prism-url;
                            edited(t) => { prism-url-edited(t); }
                        }
                        Text { text: "JWT token"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text: prism-token;
                            input-type: password;
                            edited(t) => { prism-token-edited(t); }
                        }
                    }

                    if connection-idx == 0 : VerticalLayout {
                        spacing: 8px;

                        Text { text: "Provider & model"; color: #9fb0bd; font-weight: 700; }
                        Text { text: "Model (empty = provider default)"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text: model;
                            placeholder-text: model-hint;
                            edited(t) => { model-edited(t); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Fetch models"; clicked => { fetch-models(); } }
                            Text { text: models-status; color: #8b95a1; font-size: 11px; vertical-alignment: center; }
                        }
                        if cached-models.length > 0 : VerticalLayout {
                            spacing: 2px;
                            Text { text: "Cached models (click to use)"; color: #8b95a1; font-size: 12px; }
                            for m in cached-models : Rectangle {
                                height: 24px;
                                m-ta := TouchArea {
                                    clicked => { pick-model(m); }
                                    mouse-cursor: pointer;
                                }
                                background: m-ta.has-hover ? #222a33 : transparent;
                                Text { text: m; color: #cfd8dc; font-size: 12px; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        if provider == "ollama" : VerticalLayout {
                            spacing: 4px;
                            Text { text: "Ollama URL"; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text: local-url;
                                edited(t) => { local-url-edited(t); }
                            }
                        }

                        Text { text: "API keys"; color: #9fb0bd; font-weight: 700; }
                        for k in api-keys : VerticalLayout {
                            spacing: 2px;
                            Text { text: k.label; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text: k.key;
                                input-type: password;
                                edited(t) => { key-edited(k.provider, t); }
                            }
                        }
                        Text {
                            text: "Keys are stored in plaintext, like the extension.";
                            color: #66707a;
                            font-size: 11px;
                        }

                        Text { text: "Sampling"; color: #9fb0bd; font-weight: 700; }
                        Text { text: "Temperature"; color: #8b95a1; font-size: 12px; }
                        Slider {
                            minimum: 0;
                            maximum: 2;
                            value <=> temperature;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Max tokens"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: max-tokens; edited(t) => { sampling-edited("max-tokens", t); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Top P"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: top-p; edited(t) => { sampling-edited("top-p", t); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Frequency penalty"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: freq-penalty; edited(t) => { sampling-edited("freq", t); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Presence penalty"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text: pres-penalty; edited(t) => { sampling-edited("pres", t); } }
                            }
                        }
                        Text {
                            text: "Empty = omit (server default).";
                            color: #66707a;
                            font-size: 11px;
                        }

                        Text { text: "System prompt"; color: #9fb0bd; font-weight: 700; }
                        TextEdit {
                            height: 90px;
                            text: system-prompt;
                            edited(t) => { system-prompt-edited(t); }
                        }

                        CheckBox {
                            text: "Reason in <thinking> tags first";
                            checked <=> thinking-enabled;
                        }
                        Text {
                            text: "Shown above the answer.";
                            color: #66707a;
                            font-size: 11px;
                        }

                        Text { text: "Hardware"; color: #9fb0bd; font-weight: 700; }
                        Text { text: "Preferred compute"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: compute-labels;
                            current-index <=> compute-idx;
                        }
                        Button { text: gpu-label; clicked => { cycle-gpu(); } }
                        Button { text: ctx-label; clicked => { cycle-ctx(); } }
                        Text {
                            text: "Applied via Ollama's native /api/chat when set; llama.cpp/KoboldCpp take these as launch flags.";
                            color: #66707a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Save settings"; clicked => { save-settings(); } }
                        Text { text: settings-status; color: #8b95a1; font-size: 11px; vertical-alignment: center; }
                    }

                    Text { text: "Custom providers"; color: #9fb0bd; font-weight: 700; }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Add (id, alias, base URL)"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text <=> new-provider-id;
                            placeholder-text: "id (e.g. my-proxy)";
                        }
                        ComboBox {
                            model: canonical-labels;
                            current-index <=> new-provider-canonical-idx;
                        }
                        LineEdit {
                            text <=> new-provider-url;
                            placeholder-text: "https://host/v1";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Add provider";
                                clicked => { custom-provider-add(); }
                            }
                        }
                        for kv in custom-provider-rows : Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: kv.label; color: #cfd8dc; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Button { text: "x"; clicked => { custom-provider-remove(kv.id); } }
                            }
                        }
                    }


                    // ---- character cards (SillyTavern-style) ----
                    Text { text: "Character"; color: #9fb0bd; font-weight: 700; }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Load a V2/V1 character card (JSON). The core assembles the prompt with macros + lore.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> card-path;
                            placeholder-text: "/path/to/character-card.json";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Load card"; clicked => { card-load(); } }
                            Button { text: "Clear"; clicked => { card-clear(); } }
                        }
                        if card-loaded : Text {
                            text: card-summary;
                            color: #7ee787;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text { text: "Persona (your character)"; color: #8b95a1; font-size: 11px; }
                        LineEdit {
                            text <=> persona-name;
                            placeholder-text: "Name";
                            edited(t) => { persona-edited(t, persona-desc); }
                        }
                        LineEdit {
                            text <=> persona-desc;
                            placeholder-text: "Description";
                            edited(t) => { persona-edited(persona-name, t); }
                        }
                        CheckBox {
                            text: "Use the core prompt engine";
                            checked <=> prompt-engine-on;
                            toggled => { prompt-engine-toggle(); }
                        }
                    }

                    // ---- mode mixing / capability / permission editors ----
                    // These are the same contract the core defines: a
                    // blend of modes, per-feature overrides, and the
                    // per-tool policy.
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Mode & capabilities"; color: #9fb0bd; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Blend"; clicked => { mix-editor-toggle(); } }
                            Button { text: "Capabilities"; clicked => { cap-editor-toggle(); } }
                            Button { text: "Permissions"; clicked => { perm-editor-toggle(); } }
                        }
                        Text {
                            text: pmode-blend-summary;
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    if show-cap-editor : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Capabilities"; color: #7ee787; font-weight: 700; }
                        for cap in cap-rows : Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: cap.group;
                                    color: #66707a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    width: 18px;
                                }
                                Text {
                                    text: cap.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    clicked => { cap-toggle(cap.id); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    if show-perm-editor : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Permissions"; color: #7ee787; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "default: " + perm-default;
                                color: #8b95a1;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button { text: "Cycle"; clicked => { perm-default-cycle(); } }
                        }
                        for perm in perm-rows : Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: perm.group;
                                    color: #66707a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    width: 42px;
                                }
                                Text {
                                    text: perm.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    clicked => { perm-cycle(perm.title); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }

                    // ---- agent mode: tools are gated by permissions on
                    //      the core side; the surface picks strategy + task
                    if mode-tools : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Agent"; color: #9fb0bd; font-weight: 700; }
                        ComboBox {
                            model: ["ReAct", "Plan & execute"];
                            current-index <=> agent-strategy-idx;
                        }
                        TextEdit {
                            height: 60px;
                            text <=> agent-task;
                            placeholder-text: "Task for the agent (tools available)";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: agent-busy ? "Running…" : "Run agent";
                                enabled: !agent-busy;
                                clicked => { agent-run(agent-task); }
                            }
                        }
                        if agent-status != "" : Text {
                            text: agent-status;
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        for step in agent-steps : Rectangle {
                            height: 26px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: step.group;
                                    color: #66707a;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: step.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // ---- daemon mode: scheduled tasks on the agent loop ----
                    if mode-tasks : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Daemon tasks"; color: #9fb0bd; font-weight: 700; }
                        LineEdit {
                            text <=> daemon-name;
                            placeholder-text: "Task name";
                        }
                        LineEdit {
                            text <=> daemon-interval;
                            placeholder-text: "Interval seconds (empty = manual)";
                        }
                        TextEdit {
                            height: 50px;
                            text <=> daemon-instruction;
                            placeholder-text: "Instruction the agent runs";
                        }
                        Button {
                            text: "Add task";
                            clicked => { daemon-add(daemon-name, daemon-instruction, daemon-interval); }
                        }
                        for t in daemon-tasks : Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: t.title;
                                    color: #cfd8dc;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Button { text: "run"; clicked => { daemon-run(t.id); } }
                                Button { text: "x"; clicked => { daemon-remove(t.id); } }
                            }
                        }
                    }

                    // ---- data sync (portable with extension) ----
                    Text { text: "Data sync"; color: #9fb0bd; font-weight: 700; }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Exchange conversations + prompts with the Prism extension.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if sync-logged-in : HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Signed in"; color: #7ee787; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Sign out"; clicked => { sync-logout(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Export"; clicked => { sync-export(); } }
                            Button { text: "Import"; clicked => { sync-import(); } }
                            Button { text: "Clear local"; clicked => { sync-clear(); } }
                        }
                        Text { text: sync-status; color: #8b95a1; font-size: 11px; wrap: word-wrap; }
                    }

                    // ---- local backup ----
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Local backup"; color: #9fb0bd; font-weight: 700; }
                        Text {
                            text: "Write every chat to a file, or read one back. A file from a newer Prism is refused.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> backup-path;
                            placeholder-text: "/path/to/prism-backup.json";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Export"; clicked => { backup-export(backup-path); } }
                            Button { text: "Import"; clicked => { backup-import(backup-path); } }
                        }
                        Text { text: backup-status; color: #8b95a1; font-size: 11px; wrap: word-wrap; }
                    }

                    // ---- generative mode: media capabilities ----
                    if mode-media : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Capability"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: gen-cap-labels;
                            current-index <=> gen-cap-idx;
                        }
                    }
                    if mode-media : VerticalLayout {
                        spacing: 4px;
                        Text { text: "Capability"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: media-kind-labels;
                            current-index <=> media-kind-idx;
                        }
                        Text { text: "Provider"; color: #8b95a1; font-size: 12px; }
                        ComboBox {
                            model: media-provider-labels;
                            current-index <=> media-provider-idx;
                        }
                        Text { text: "Base URL (empty = default)"; color: #8b95a1; font-size: 12px; }
                        LineEdit {
                            text <=> media-base-url;
                            placeholder-text: "http://127.0.0.1:8188";
                        }
                        if media-provider == "comfyui" : Text {
                            text: "ComfyUI: Model = checkpoint (or the AnimateDiff motion module for Video). Inpaint needs a source image and a mask.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text { text: "Prompt"; color: #8b95a1; font-size: 12px; }
                        TextEdit {
                            height: 60px;
                            text <=> media-prompt;
                        }
                        if media-needs-image : VerticalLayout {
                            spacing: 2px;
                            Text { text: "Source image URL"; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text <=> media-image-url;
                                placeholder-text: "https://… or data:image/png;base64,…";
                            }
                        }
                        if media-needs-mask : VerticalLayout {
                            spacing: 2px;
                            Text { text: "Mask image URL"; color: #8b95a1; font-size: 12px; }
                            LineEdit {
                                text <=> media-mask-url;
                                placeholder-text: "https://… or data:image/png;base64,…";
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Model"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-model; placeholder-text: "provider default"; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Aspect ratio"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-aspect-ratio; placeholder-text: "1:1"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Duration (s)"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-duration; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Seed"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-seed; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Format"; color: #8b95a1; font-size: 12px; }
                                LineEdit { text <=> media-format; placeholder-text: "png"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: media-busy ? "Working…" : "Generate";
                                enabled: !media-busy;
                                clicked => { media-generate(); }
                            }
                            if media-pending : Button {
                                text: "Check status";
                                clicked => { media-poll(); }
                            }
                        }
                        if media-status != "" : Text {
                            text: media-status;
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if media-result-url != "" : Text {
                            text: media-result-url;
                            color: #7fb3d5;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    // audio / transcribe / OCR capabilities (not media requests)
                    if mode-media : VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Audio / transcription / OCR use the dedicated capability services on the host.";
                            color: #8b95a1;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // ---- command palette (Ctrl+K) ----
    if palette-open : Rectangle {
        background: #00000066;
        TouchArea {
            clicked => { palette-toggle(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 60px;
            width: 520px;
            height: 420px;
            background: #161b21;
            border-width: 1px;
            border-color: #2a3440;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                LineEdit {
                    text <=> palette-query;
                    placeholder-text: "Type a command… (Ctrl+K)";
                    edited(t) => {
                        palette-query-changed(t);
                        palette-idx = 0;
                    }
                    accepted(t) => {
                        if palette-results.length > 0 && palette-idx < palette-results.length {
                            palette-execute(palette-results[palette-idx].id);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: #232a31;
                }
                palette-list := ListView {
                    vertical-stretch: 1;
                    for r[i] in palette-results : Rectangle {
                        height: 28px;
                        background: i == palette-idx ? #223040 : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            TouchArea {
                                clicked => { palette-execute(r.id); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: r.title;
                                color: i == palette-idx ? #ffffff : #cfd8dc;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.group;
                                color: #66707a;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "Enter run · Esc close · ↑/↓ select";
                    color: #55606a;
                    font-size: 10px;
                }
            }
        }
    }

    // ---- search panel (Ctrl+F) ----
    if search-open : Rectangle {
        background: #00000066;
        TouchArea {
            clicked => { search-toggle(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 50px;
            width: 720px;
            height: 560px;
            background: #161b21;
            border-width: 1px;
            border-color: #2a3440;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                search-input := FocusScope {
                    LineEdit {
                        text <=> search-query;
                        placeholder-text: "Search messages…";
                        edited(t) => { search-run(); }
                        accepted => { search-run(); }
                    }
                    init => { search-input.focus(); }
                }

                // ---- filters ----
                HorizontalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "Regex";
                        checked <=> search-regex;
                        toggled => { search-run(); }
                    }
                    CheckBox {
                        text: "Match case";
                        checked <=> search-case-sensitive;
                        toggled => { search-run(); }
                    }
                    CheckBox {
                        text: "Unread only";
                        checked <=> search-unread-only;
                        toggled => { search-run(); }
                    }
                    CheckBox {
                        text: "Include archived";
                        checked <=> search-include-archived;
                        toggled => { search-run(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Role";
                        color: #66707a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: search-role-labels;
                        current-index <=> search-role-idx;
                        selected => { search-run(); }
                    }
                    Text {
                        text: "Sort";
                        color: #66707a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: search-sort-labels;
                        current-index <=> search-sort-idx;
                        selected => { search-run(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: "Tag";
                        text <=> search-tag;
                        edited(t) => { search-run(); }
                    }
                    LineEdit {
                        placeholder-text: "File / URL filter";
                        text <=> search-file;
                        edited(t) => { search-run(); }
                    }
                }

                Text {
                    text: search-status;
                    color: #66707a;
                    font-size: 11px;
                }

                Rectangle {
                    height: 1px;
                    background: #232a31;
                }

                ListView {
                    vertical-stretch: 1;
                    for r in search-results : Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            TouchArea {
                                clicked => { search-jump(r.conversation-id, r.message-index); }
                                mouse-cursor: pointer;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text {
                                    text: r.conversation-title;
                                    color: #82aaff;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                Text {
                                    text: r.preview;
                                    color: #cfd8dc;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: r.role;
                                color: #66707a;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Close";
                        clicked => { search-toggle(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }

    // ---- context panel ----
    if context-items.length > 0 : Rectangle {
        x: parent.width - 260px;
        y: 40px;
        width: 250px;
        height: 260px;
        background: #161b21;
        border-width: 1px;
        border-color: #2a3440;
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text {
                text: "Context";
                color: #cfd8dc;
                font-weight: 700;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Budget";
                    color: #66707a;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                LineEdit {
                    text <=> context-budget;
                    edited(t) => { context-budget = t; }
                }
            }
            Text {
                text: context-status;
                color: #66707a;
                font-size: 10px;
            }
            ListView {
                vertical-stretch: 1;
                for item in context-items : Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        spacing: 6px;
                        CheckBox {
                            checked <=> item.enabled;
                            toggled => { context-toggle(item.id, self.checked); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: item.title;
                                color: #cfd8dc;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: item.source;
                                color: #66707a;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: item.tokens;
                            color: #66707a;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "×";
                            width: 24px;
                            clicked => { context-remove(item.id); }
                        }
                    }
                }
            }
        }
    }
}
