{
  "name": "@prism/desktop",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/desktop"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "@prism/desktop:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "@prism/desktop:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "@prism/desktop:build:production",
          "hmr": false
        }
      }
    }
  },
  "tags": []
}
