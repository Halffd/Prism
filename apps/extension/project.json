{
  "name": "@prism/extension",
  "projectType": "application",
  "sourceRoot": "apps/extension/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/extension"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "@prism/extension:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "@prism/extension:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "@prism/extension:build:production",
          "hmr": false
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/apps/extension"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "firefox": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/apps/extension-firefox"],
      "options": {
        "command": "bash apps/extension/scripts/build-firefox.sh"
      }
    },
    "firefox:lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx web-ext lint --source-dir dist/apps/extension --self-hosted"
      }
    }
  },
  "tags": []
}